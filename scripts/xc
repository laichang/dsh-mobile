#!/bin/bash
# xcodebuild with a short JSON summary (counts, the first errors as file:line). The full log goes
# to --log FILE or to /tmp/dshm-logs/. The exit code is the exit code of xcodebuild.
#
#   scripts/xc build|test|build-for-testing|test-without-building [--log FILE] [xcodebuild args…]
#
# With no -project, it adds the project, the scheme and the resolved package versions. With no
# -destination, it uses $DSHM_SIM (a build with no DSHM_SIM uses a generic destination).
# $DSHM_DD sets -derivedDataPath. A test action outside a demo script loads the machine guard of
# scripts/demo/lib.sh (the machine guard). Summary format: scripts/lib/wrap.py.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ -n "${DSHM_SIM:-}" ] && [[ " $* " != *" -destination "* ]]; then
  "$ROOT/scripts/slice-env" --check-sim "$DSHM_SIM"
fi
case "${1:-}" in
  test|test-without-building)
    if [ -z "${DSHM_GUARD_OWNER:-}" ] && [ -n "${DSHM_SIM:-}" ]; then
      SIM="$DSHM_SIM"; source "$ROOT/scripts/demo/lib.sh"
    fi ;;
esac
exec python3 "$ROOT/scripts/lib/wrap.py" run xc "$@"
