#!/usr/bin/env python3
"""Finds comments that an ID removal left damaged, in the lines changed since a base.

  scripts/check-id-removal [BASE]   check the work tree against the merge base with BASE (default: main); no base, no check

For each changed line it compares the new text with the old one (the n-th removed line of a hunk
with its n-th added line) and reports a new:
  - comment line that is only punctuation (`//.`, `///.`, `# .`)
  - comment that ends in a word that needs more: see, per, follows, as in, from, by, in, after,
    since, like, with, of, "(" or ":" after such a word
  - word joined to a dot or comma where the old line had a space ("the .txt" -> "the.txt")
  - empty parentheses or brackets, a double space, or a space before punctuation
that the old line did not have. Exit 0 = none, 1 = a damaged comment (path:line: why: text).
"""
import re
import subprocess
import sys

COMMENT = re.compile(r'^\s*(///?|#|\*|/\*\*?|<!--)(?!!)')
TRAIL = re.compile(r'(//|#|\*|<!--)\s*(.*)$')
DANGLING = re.compile(r'\b(see|per|follows|as in|from|by|in|after|since|like|with|of|and|or|the|to|on|at|for)\s*[:(]?\s*[.,;]?\s*(-->|\*/)?$', re.I)


def body(line):
    """The comment text of a line, or None when the line has no comment."""
    if COMMENT.match(line):
        return re.sub(r'^\s*(///?|#|\*|/\*\*?|<!--)\s?', '', line)
    m = re.search(r'\s(//|#)\s(.*)$', line)
    return m.group(2) if m else None


def problems(old, new):
    """Why the new line looks damaged compared to the old one ([] when it does not)."""
    b, ob = body(new), body(old) or ''
    if b is None:
        return []
    out = []
    if COMMENT.match(new) and re.fullmatch(r'[\s.,;:·—–\-()]*', b) and b.strip():
        out.append('a comment of only punctuation')
    if DANGLING.search(b.strip()) and not DANGLING.search(ob.strip()):
        out.append('ends in a word that needs more')
    for pair in (' .', ' ,'):
        if old.count(pair) > new.count(pair) and re.search(r'\w' + re.escape(pair.strip()) + r'\w', new):
            out.append(f'a lost space before "{pair.strip()}"')
    for empty in ('()', '[]', '（）'):
        if new.count(empty) > old.count(empty):
            out.append(f'empty {empty}')
    if b.strip().count('  ') > ob.strip().count('  '):
        out.append('a double space')
    if len(re.findall(r'\w \s*[.,;:)]', b)) > len(re.findall(r'\w \s*[.,;:)]', ob)):
        out.append('a space before punctuation')
    return out


def pairs(base):
    mb = subprocess.run(['git', 'merge-base', base, 'HEAD'], capture_output=True, text=True, check=True).stdout.strip()
    d = subprocess.run(['git', 'diff', mb, '-U0', '-M', '--', 'ios', 'bridge',
                        'protocol', 'scripts', 'design'], capture_output=True, check=True).stdout.decode('utf-8', 'replace')
    path = None
    hunk = None
    for line in d.split('\n') + ['@@ end']:
        if line.startswith('@@') or line.startswith('diff '):
            if hunk:
                for i, (o, n) in enumerate(zip(hunk['old'], hunk['new'])):
                    yield path, hunk['start'] + i, o, n
            hunk = None
            m = re.match(r'@@ -\S+ \+(\d+)', line)
            if m:
                hunk = {'start': int(m.group(1)), 'old': [], 'new': []}
        elif line.startswith('+++ '):
            path = line[6:]
        elif hunk is not None and line.startswith('-') and not line.startswith('---'):
            hunk['old'].append(line[1:])
        elif hunk is not None and line.startswith('+'):
            hunk['new'].append(line[1:])


def main():
    base = sys.argv[1] if len(sys.argv) > 1 else 'main'
    if subprocess.run(['git', 'rev-parse', '-q', '--verify', base], capture_output=True).returncode:
        print(f'check-id-removal: no {base}, nothing to check')
        return 0
    hits = []
    for path, n, old, new in pairs(base):
        if re.search(r'\.(png|binpb|json)$', path or ''):
            continue
        for why in problems(old, new):
            hits.append(f'{path}:{n}: {why}: {new.strip()[:120]}')
    print('\n'.join(hits)) if hits else print(f'check-id-removal: no damaged comment since {base}')
    return 1 if hits else 0


if __name__ == '__main__':
    sys.exit(main())
