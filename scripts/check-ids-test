#!/usr/bin/env python3
"""Tests scripts/check-ids on small fixture trees, then on this repo.
  scripts/check-ids-test   ends with `failures: 0`; exit 1 on a failure."""
import os
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
CHECK = os.path.join(HERE, 'check-ids')
failures = 0


def run(root):
    return subprocess.run([sys.executable, CHECK, root], capture_output=True, text=True)


def expect(name, files, code, want=''):
    """files: {path: text}. code: the exit code; want: a part of stdout."""
    global failures
    with tempfile.TemporaryDirectory() as d:
        for p, t in files.items():
            os.makedirs(os.path.dirname(os.path.join(d, p)), exist_ok=True)
            with open(os.path.join(d, p), 'w', encoding='utf-8') as f:
                f.write(t)
        r = run(d)
    ok = r.returncode == code and want in r.stdout
    failures += not ok
    print(f"{'ok  ' if ok else 'FAIL'} {name}")
    if not ok:
        print(f'     exit {r.returncode}, want {code} and {want!r}\n     {r.stdout.strip()}')


CLEAN = {'ios/App/Drawer.swift': '// The drawer groups sessions by workspace.\nstruct Drawer {}\n',
         'bridge/src/x.ts': "export const port = 47810 // X1 and P3 are design screens\n",
         'design/screens/X1.html': '<li>模型失效</li>\n'}
expect('a tree without IDs passes', CLEAN, 0, 'no decision or slice ID')
expect('D18 in a Swift comment fails', {**CLEAN, 'ios/App/A.swift': '/// Saved path (D18).\n'}, 1,
       'ios/App/A.swift:1: decision ID D18')
expect('S14 in a TS comment fails', {**CLEAN, 'bridge/src/a.ts': '// S14 · the drawer\n'}, 1,
       'bridge/src/a.ts:1: slice ID S14')
expect('T0 in a script string fails', {**CLEAN, 'scripts/demo/a.sh': 'step "T0 demo passed"\n'}, 1, 'slice ID T0')
expect('a test class named with a slice ID fails',
       {**CLEAN, 'ios/UITests/Drawer.swift': 'final class S14DrawerUITests {}\n'}, 1, 'slice ID S14')
expect('a token named with a slice ID fails', {**CLEAN, 'ios/App/T.swift': 'let hostsS21 = 1\n'}, 1, 'slice ID S21')
expect('an env name with a slice ID fails', {**CLEAN, 'scripts/a.sh': 'echo "$DSHM_S4_COMMAND"\n'}, 1,
       'slice ID S4')
expect('a file named with a slice ID fails', {**CLEAN, 'scripts/demo/s14.sh': 'echo drawer\n'}, 1,
       'scripts/demo/s14.sh: file name with ID s14')
expect('a proto named with a slice ID fails', {**CLEAN, 'protocol/s2.proto': 'syntax = "proto3";\n'}, 1,
       'file name with ID s2')
expect('a file named with a decision ID fails', {**CLEAN, 'design/D18.html': '<p></p>\n'}, 1, 'file name with ID D18')
expect('hex and screen names pass', {**CLEAN, 'ios/App/C.swift': 'let c = 0xD8; let k = "D5A1F0"; // F4, V2, X3\n'}, 0)
expect('a line with the keep marker passes',
       {**CLEAN, 'bridge/test/g.ts': "hostName: 'Mac mini (S1)', // check-ids: keep (golden)\n"}, 0)
expect('the plan tools are skipped', {**CLEAN, 'scripts/plan': 'ids = ["S14", "T0"]\n'}, 0)
expect('protocol/fixtures is skipped', {**CLEAN, 'protocol/fixtures/x.json': '{"name": "S14"}\n'}, 0)
expect('docs outside the code areas are not checked (check-docs does)', {**CLEAN, 'NOTES.md': 'D18\n'}, 0)

# scripts/check-id-removal: comments that an ID removal left damaged.
REMOVAL = os.path.join(HERE, 'check-id-removal')
g = {}
exec(open(REMOVAL).read().replace("if __name__ == '__main__':", "if False:"), g)
for name, old, new, bad in [
    ('a comment of only punctuation', '// ARCHITECTURE D6.', '//.', True),
    ('a dangling "see"', '// Hand-rolled: see D6.', '// Hand-rolled: see.', True),
    ('a dangling "follows"', '/// Copy follows S11.', '/// Copy follows.', True),
    ('a lost space before a dot', '/// D107: a .txt file', '/// A.txt file', True),
    ('empty parentheses', '// the reply (D18).', '// the reply ().', True),
    ('a double space', '// the reply (D18) here.', '// the reply  here.', True),
    ('a clean removal', '/// Saved path (D18).', '/// Saved path.', False),
    ('code is not a comment', 'let a = b // D17', 'let a = b', False),
]:
    got = bool(g['problems'](old, new))
    ok = got == bad
    failures += not ok
    print(f"{'ok  ' if ok else 'FAIL'} check-id-removal: {name}")
r = subprocess.run([sys.executable, REMOVAL], capture_output=True, text=True, cwd=os.path.dirname(HERE))
ok = r.returncode == 0
failures += not ok
print(f"{'ok  ' if ok else 'FAIL'} check-id-removal: no damaged comment since main")
if not ok:
    print(r.stdout[:2000])

r = run(os.path.dirname(HERE))
ok = r.returncode == 0
failures += not ok
print(f"{'ok  ' if ok else 'FAIL'} this repo has no decision or slice ID in code")
if not ok:
    print(r.stdout[:2000])
print(f'failures: {failures}')
sys.exit(1 if failures else 0)
