#!/usr/bin/env python3
"""Tests for scripts/check-design and the Screens section of scripts/brief, in temporary copies
(the repo is not touched).

  scripts/check-design-test [design|theme|brief]...    default: all; ends with "failures: 0"

design: check-design passes on this checkout, and fails on a copy with a STORY principle that no
        screen serves, a cycle in needs, a rule whose XCUITest does not exist, a nav target that is
        not a node, and a screen without its html.
theme:  check-design fails on a DSHTheme file named with a slice ID (Theme+S14.swift) and on a
        DSHTheme token named with one (s19FailFill, hostsS21); a feature name passes.
brief:  in a clone, a node whose items name screens gets a Screens section from design/screens.json
        (title, html, STORY sections, rules with their XCUITests; more than 6 screens are named
        only), check-design in its commands; the largest node with screens on each item stays at
        3k tokens or fewer, with the checks of scripts/brief-test.
Exit 1 on a failure.
"""

import importlib.machinery
import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

SRC = Path(__file__).resolve().parent.parent
CHECK = SRC / "scripts/check-design"
fails = 0


def ok(name, detail=""):
    print(f"  ok    {name}")


def bad(name, detail=""):
    global fails
    fails += 1
    print(f"  FAIL  {name}")
    for line in detail.splitlines()[:12]:
        print(f"        {line}")


def run_check(root):
    return subprocess.run([sys.executable, "-I", str(CHECK), "--root", str(root)], capture_output=True, text=True)


def copy_tree(tmp):
    """The files that check-design reads, copied from this checkout."""
    root = tmp / "repo"
    for rel in ("design", "ios/dsh-mobile", "ios/dsh-mobileUITests", "ios/LiveActivity"):
        shutil.copytree(SRC / rel, root / rel, ignore=shutil.ignore_patterns("*.png", "*.xcassets"))
    for png in (SRC / "design/screens").glob("*.png"):
        (root / "design/screens" / png.name).write_bytes(b"")      # check-design needs the file only
    shutil.copy2(SRC / "STORY.md", root / "STORY.md")
    return root


def expect_fail(name, root, needle):
    r = run_check(root)
    if r.returncode == 1 and needle in r.stdout:
        ok(name)
    else:
        bad(name, f"exit {r.returncode}, want 1 with {needle!r}\n" + r.stdout + r.stderr)


def edit_json(root, fn):
    p = root / "design/screens.json"
    data = json.loads(p.read_text())
    fn(data["nodes"])
    p.write_text(json.dumps(data, ensure_ascii=False, indent=2))


def node(nodes, nid):
    return next(n for n in nodes if n["id"] == nid)


def test_design(tmp):
    print("design")
    r = run_check(SRC)
    (ok if r.returncode == 0 and "check-design: ok" in r.stdout else bad)(
        "check-design passes on this checkout", r.stdout + r.stderr)

    root = copy_tree(tmp / "story")
    story = root / "STORY.md"
    story.write_text(story.read_text().replace("# 暂不做", "## 10. 一条新原则\n\n还没有画面。\n\n# 暂不做", 1))
    expect_fail("a STORY principle without a screen fails", root, "STORY.md §10 has no screen")

    root = copy_tree(tmp / "cycle")
    edit_json(root, lambda ns: node(ns, "drawer")["needs"].append("F1"))     # F1 -> 02 -> drawer -> F1
    expect_fail("a cycle in needs fails", root, "needs has a cycle")

    root = copy_tree(tmp / "test")
    edit_json(root, lambda ns: node(ns, "04")["rules"].append({"text": "x", "test": "testNoSuchThingAnywhere"}))
    expect_fail("a rule whose XCUITest does not exist fails", root, "testNoSuchThingAnywhere is not an XCUITest")

    root = copy_tree(tmp / "nav")
    edit_json(root, lambda ns: node(ns, "01")["nav"].append({"to": "Z9", "by": "tap"}))
    expect_fail("a nav target that is not a node fails", root, "nav")

    root = copy_tree(tmp / "html")
    (root / "design/screens/X3.html").unlink()
    expect_fail("a screen without its html fails", root, "no design/screens/X3.html")


def test_theme(tmp):
    print("theme")
    root = copy_tree(tmp / "file")
    d = root / "ios/dsh-mobile/Features/Drawer"
    (d / "Theme+Drawer.swift").rename(d / "Theme+S14.swift")
    expect_fail("a DSHTheme file named with a slice ID fails", root, "Theme+S14.swift: the file name")

    for token in ("s19FailFill", "hostsS21"):
        root = copy_tree(tmp / f"token-{token}")
        p = root / "ios/dsh-mobile/Features/Outcomes/Theme+Outcomes.swift"
        p.write_text(p.read_text().replace("static let failFill", f"static let {token}"))
        expect_fail(f"a DSHTheme token named {token} fails", root, f"DSHTheme.{token} has a slice ID")

    root = copy_tree(tmp / "feature")
    p = root / "ios/dsh-mobile/Features/Outcomes/Theme+Outcomes.swift"
    p.write_text(p.read_text().replace("static let failFill", "static let failCardFill"))
    r = run_check(root)
    (ok if r.returncode == 0 else bad)("a feature name passes (failCardFill)", r.stdout)


def git(repo, *args):
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, check=True).stdout


def test_brief(tmp):
    print("brief")
    bt = importlib.machinery.SourceFileLoader("brief_test", str(SRC / "scripts/brief-test")).load_module()
    repo = tmp / "clone"
    subprocess.run(["git", "clone", "-q", str(SRC), str(repo)], check=True)
    for rel in ("scripts/brief", "scripts/check-design", "scripts/render-design", "scripts/check-docs",
                "scripts/lib", "plan", "design", "AGENTS.md", "ARCHITECTURE.md", "STORY.md"):
        dst = repo / rel
        if dst.is_dir():
            shutil.rmtree(dst)
        if (SRC / rel).is_dir():
            shutil.copytree(SRC / rel, dst, ignore=shutil.ignore_patterns("__pycache__"))
        else:
            shutil.copy2(SRC / rel, dst)
    git(repo, "config", "user.name", "t")
    git(repo, "config", "user.email", "t@t")
    git(repo, "add", "-A")
    git(repo, "commit", "-q", "--allow-empty", "-m", "overlay")

    screens = json.loads((SRC / "design/screens.json").read_text())["nodes"]
    ids = [n["id"] for n in screens if n["type"] == "screen"]

    out = tmp / "brief-S98.md"

    def brief_of(label, items):
        plan, _, scope = bt.largest_node()
        bt.commit_plan(repo, label.replace(" ", "-"), plan, {"S98": items}, scope)
        r = subprocess.run([str(repo / "scripts/brief"), "S98", "--out", str(out)], cwd=repo, capture_output=True, text=True)
        if r.returncode != 0:
            bad(f"{label}: brief exits 0", r.stderr)
            return None
        text = out.read_text()
        before = bt.fails
        bt.check_brief(f"{label} S98", text, bt.tree(repo))
        if bt.fails == before:
            ok(f"{label}: the brief passes the checks of scripts/brief-test (3k tokens, paths, commands, facts)")
        return text

    def full(text, sid):
        n = next(n for n in screens if n["id"] == sid)
        return (f"- {sid} · {n['title']}: `design/screens/{sid}.html`" in text
                and "STORY " + " ".join(n["story"]) in text
                and (not n["rules"] or f"(`{n['rules'][0]['test']}`)" in text))

    # A UI node: two items on app files, 8 screens on the items and one screen file.
    items = [{"tier": "auto", "text": "The drawer and the session page keep their rules", "passed": False,
              "files": ["ios/dsh-mobile/Shell/DrawerView.swift", "design/screens/M.html"],
              "screens": ids[:4], "evidence": ["cmd:scripts/check-design"]},
             {"tier": "ui", "text": "The screens show as drawn", "passed": False,
              "files": ["ios/dsh-mobile/Shell/ShellView.swift"], "screens": ids[3:8],
              "evidence": ["cmd:scripts/render-design 01"]}]
    text = brief_of("ui node", items)
    if text is not None:
        sec = text[text.find("## Screens"):text.find("## Commands")]
        checks = [
            ("the brief has a Screens section", "## Screens" in text),
            ("the first screens have title, html, STORY sections and rules with their XCUITests",
             all(full(text, s) for s in ids[:3])),
            ("a screen that a file names is in the section", "M · " in sec or "M:" in sec or ", M" in sec),
            ("each screen of the items is in the section", all(f"- {s} · " in sec or f" {s}," in sec or f" {s}:" in sec
                                                               for s in ids[:8])),
            ("check-design is in the commands", "- `scripts/check-design`:" in text),
        ]
        for name, cond in checks:
            (ok if cond else bad)(f"ui node: {name}", "" if cond else sec[:1500])

    # The largest node of scripts/brief-test, with screens on its items: the screens fill what is left.
    plan, items, scope = bt.largest_node()
    items = items["S98"]
    items[0]["screens"] = ids[:4]
    items[1]["screens"] = ids[3:7]
    text = brief_of("largest node", items)
    if text is not None:
        sec = text[text.find("## Screens"):text.find("## Commands")]
        cond = full(text, ids[0]) and f"- Also: " in sec and ids[6] in sec
        (ok if cond else bad)("largest node: the first screen in full, the others named in one line", sec[:1500])

    # A node without screens has no Screens section.
    git(repo, "checkout", "-q", "-B", "none")
    plan2, items2, scope2 = bt.largest_node()
    bt.commit_plan(repo, "none", plan2, items2, scope2)
    r = subprocess.run([str(repo / "scripts/brief"), "S98", "--out", str(out)], cwd=repo, capture_output=True, text=True)
    (ok if r.returncode == 0 and "## Screens" not in out.read_text() else bad)("a node without screens has no Screens section")


def main():
    parts = sys.argv[1:] or ["design", "theme", "brief"]
    unknown = [p for p in parts if p not in ("design", "theme", "brief")]
    if unknown:
        print(f"check-design-test: unknown part {unknown[0]} (design, theme, brief)", file=sys.stderr)
        return 2
    tmp = Path(tempfile.mkdtemp(prefix="dshm-check-design-test."))
    try:
        for p in parts:
            (tmp / p).mkdir()
            {"design": test_design, "theme": test_theme, "brief": test_brief}[p](tmp / p)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    print(f"failures: {fails}")
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
