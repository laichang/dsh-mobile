#!/bin/bash
# Node test of the run-plan Workflow (.claude/workflows/run-plan.js) with a fake agent(): scheduling,
# prompts, the rework loop, fixes and the return (scripted agent), and one node from brief to merge
# in a temporary clone (real shell steps). The repo is not touched.
#   scripts/run-plan-test [--test-name-pattern=RE]   ends with "fail 0"
set -euo pipefail
ROOT=$(git rev-parse --show-toplevel)
exec node --test --test-reporter=spec "$@" "$ROOT/scripts/test/run-plan.test.mjs"
