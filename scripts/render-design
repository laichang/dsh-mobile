#!/bin/bash
# Render each design/screens/<id>.html to design/screens/<id>.png with headless Chrome.
#   scripts/render-design            every screen of design/screens/
#   scripts/render-design <id>...    only these screens (01, F1, X2, P3, ...)
# A screen file holds one phone and its caption; it loads the shared kit (design/kit/kit.css,
# design/kit/kit.js). ?shot hides the caption, so the png is the phone only: 441 x 900 pt at 2x.
# After the render it checks that each rendered screen has a png of 882 x 1800 pixels.
# Exit 0 = each screen rendered, 1 = a screen has no png or a wrong size, or no Chrome.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CHROME="${CHROME:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
[ -x "$CHROME" ] || { echo "render-design: set CHROME to a Chrome or Chromium binary" >&2; exit 1; }
DIR="$ROOT/design/screens"

if [ $# -gt 0 ]; then ids=("$@"); else
  ids=(); for f in "$DIR"/*.html; do ids+=("$(basename "$f" .html)"); done
fi

bad=0
for id in "${ids[@]}"; do
  html="$DIR/$id.html" png="$DIR/$id.png"
  [ -f "$html" ] || { echo "render-design: no $html" >&2; bad=$((bad + 1)); continue; }
  rm -f "$png"
  "$CHROME" --headless=new --disable-gpu --hide-scrollbars --force-device-scale-factor=2 \
    --window-size=441,900 --screenshot="$png" "file://$html?shot" >/dev/null 2>&1 || true
  size=$(sips -g pixelWidth -g pixelHeight "$png" 2>/dev/null | awk '/pixel/ {printf "%s ", $2}')
  if [ "$size" != "882 1800 " ]; then
    echo "render-design: $id.png is missing or not 882 x 1800 (${size:-none})" >&2
    bad=$((bad + 1))
  fi
done
echo "render-design: ${#ids[@]} screens, $bad failed"
[ "$bad" -eq 0 ]
