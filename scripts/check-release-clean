#!/bin/bash
# Inspect what the two build configurations actually ship.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.dshm/bin:$HOME/.nvm/versions/node/v24.14.0/bin:$PATH"
run=$(mktemp -d)
trap 'rm -rf "$run"' EXIT
dd="${DSHM_RELEASE_DD:-$run/dd}"
for config in Debug Release; do
  scripts/xc build -project ios/dsh-mobile.xcodeproj -scheme dsh-mobile -configuration "$config" \
    -destination 'generic/platform=iOS Simulator' -derivedDataPath "$dd" \
    -onlyUsePackageVersionsFromResolvedFile -skipPackageUpdates CODE_SIGNING_ALLOWED=NO --log "$run/$config.log" || {
      tail -20 "$run/$config.log"; exit 1
    }
done

(cd bridge && corepack pnpm install --frozen-lockfile >/dev/null && corepack pnpm build)
python3 - "$dd/Build/Products" <<'PY'
import json
import plistlib
import subprocess
import sys
from pathlib import Path

products = Path(sys.argv[1])
debug_hooks = {
    'FakeBridge', 'FakeHost', 'FakeNoiseHost', 'DSHMFakeBridge', 'DSHMPresetPrompt', 'DSHMBridgePort',
    'DSHMFakeMilestones', 'DSHMResetStore', 'DSHMConnectDelay', 'DSHMResetPairing', 'DSHMFakeHold',
    'DSHMFakeScenario', 'DSHMFakeAsk', 'DSHMFakeSpeech', 'FakeTranscriber', 'DebugDeepLink',
    'DebugLaunchOptions', 'DSHMLiveActivityProbe', 'DSHMSeedLegacyPairing', 'DSHM_TLS_TEST_PIN',
}
legacy = {'Noise_IK', 'NoiseInitiator', 'NoiseResponder', 'NoiseChannel', 'PlaintextChannel', '/plaintext', 'ws://'}
for config in ('Debug', 'Release'):
    app = products / (config + '-iphonesimulator') / 'dsh-mobile.app'
    info = plistlib.loads((app / 'Info.plist').read_bytes())
    if 'NSAppTransportSecurity' in info or 'CFBundleURLTypes' in info:
        sys.exit(f'{config} ships an ATS override or URL scheme')
    binaries = [p for p in app.rglob('*') if p.is_file()
                and b'Mach-O' in subprocess.check_output(['file', '-b', p])]
    if not binaries:
        sys.exit(f'No Mach-O binaries found in {app}')
    strings = b'\n'.join(subprocess.check_output(['strings', '-a', p]) for p in binaries)
    def found(markers):
        return sorted(m for m in markers if m.encode() in strings)
    obsolete, hooks = found(legacy), found(debug_hooks)
    if obsolete or (config == 'Release' and hooks):
        sys.exit(f'{config}: unexpected markers {obsolete + (hooks if config == "Release" else [])}')
    if config == 'Debug' and not hooks:
        sys.exit('Debug build has no expected testability markers')
    if b'/enroll' not in strings or b'Authorization' not in strings:
        sys.exit(f'{config}: missing TLS enrollment or authenticated upgrade')
    print(f'{config}: {len(binaries)} Mach-O products checked')
bridge = Path('bridge')
manifest = json.loads((bridge / 'package.json').read_text())
if any(name.startswith('@noble/') for name in manifest['dependencies']):
    sys.exit('Bridge still has a legacy crypto runtime dependency')
files = [*(bridge / 'lib/src').rglob('*.js'), bridge / 'lib/scripts/pair.js']
if not (bridge / 'lib/src/index.js').is_file():
    sys.exit('Bridge entry point missing')
for path in files:
    if any(marker in path.read_text() for marker in legacy | {'@noble/', 'devPlaintext'}):
        sys.exit(f'Legacy transport in bridge build: {path}')
PY
echo 'check-release-clean: product checks passed'
