#!/bin/bash
# Proves a Release build carries none of the debug-only testability entry points
#: FakeBridge, the -DSHM* launch arguments, and the dshm://pair deep link;
# and no PlaintextChannel: Release talks to a bridge only over Noise.
# And both builds carry the same ATS keys.
# Also checks the Debug build *does* carry them, so a passing result means something.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DD="${DSHM_RELEASE_DD:-/tmp/dshm-release-check-dd}" # per worktree, so parallel slices don't share a build DB
MARKERS=(FakeBridge FakeHost FakeNoiseHost DSHMFakeBridge DSHMPresetPrompt DSHMBridgePort DSHMFakeMilestones DSHMResetStore DSHMConnectDelay DSHMResetPairing DSHMFakeHold DSHMFakeScenario DSHMFakeAsk DSHMFakeSpeech FakeTranscriber DebugDeepLink DebugLaunchOptions DSHMLiveActivityProbe PlaintextChannel /plaintext)

build() {
  xcodebuild build -project "$ROOT/ios/dsh-mobile.xcodeproj" -scheme dsh-mobile -configuration "$1" \
    -destination 'generic/platform=iOS Simulator' -derivedDataPath "$DD" \
    -onlyUsePackageVersionsFromResolvedFile -skipPackageUpdates CODE_SIGNING_ALLOWED=NO >/tmp/dshm-release-check-$1.log 2>&1 \
    || { tail -20 /tmp/dshm-release-check-$1.log; exit 1; }
  echo "$DD/Build/Products/$1-iphonesimulator/dsh-mobile.app"
}

scan() { # app → prints markers found in any Mach-O inside, and URL schemes
  local app=$1 found=()
  local binaries; binaries=$(find "$app" -type f -exec sh -c 'file -b "$1" | grep -q Mach-O' _ {} \; -print)
  for m in "${MARKERS[@]}"; do
    for b in $binaries; do grep -q -- "$m" < <(strings -a "$b") && { found+=("$m"); break; }; done
  done
  /usr/libexec/PlistBuddy -c 'Print :CFBundleURLTypes' "$app/Info.plist" >/dev/null 2>&1 && found+=("CFBundleURLTypes")
  echo "${found[*]:-}"
}

# ATS behaves the same in both: the phone reaches the bridge at any IP in the QR.
ats() { plutil -extract NSAppTransportSecurity xml1 -o - "$1/Info.plist" 2>/dev/null || echo none; }
release_app=$(build Release)
debug_app=$(build Debug)
release=$(scan "$release_app")
debug=$(scan "$debug_app")
[ "$(ats "$release_app")" = "$(ats "$debug_app")" ] || { echo "check-release-clean: FAIL, NSAppTransportSecurity differs between Debug and Release" >&2; exit 1; }
[ "$(plutil -extract NSAppTransportSecurity.NSAllowsArbitraryLoads raw -o - "$release_app/Info.plist" 2>/dev/null)" = true ] \
  || { echo "check-release-clean: FAIL, Release lacks NSAllowsArbitraryLoads" >&2; exit 1; }
echo "Debug carries:   ${debug:-<none>}"
echo "Release carries: ${release:-<none>}"
[ -n "$debug" ] || { echo "check-release-clean: Debug has no markers; the check is broken" >&2; exit 1; }
[ -z "$release" ] || { echo "check-release-clean: FAIL, Release contains: $release" >&2; exit 1; }
echo "check-release-clean: OK, Release contains none of the testability entry points"
