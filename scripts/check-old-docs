#!/bin/bash
# Fails when a living doc, a skill, a script or a hook names a removed process doc (the old
# process file or the old plan template). plan/ (the history of a run) and spikes/ (working
# notes) are not living docs. Exit 0 = none, 1 = found (each line names the file).
#   scripts/check-old-docs
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
OLD='WORKFLOW\.md|plan-template\.md'
hits=$(git ls-files -co --exclude-standard -- . ':!plan/' ':!spikes/' ':!evidence/' ':!scripts/check-old-docs' \
  | while IFS= read -r f; do [ -f "$f" ] && grep -nIE "$OLD" "$f" /dev/null; done)
if [ -n "$hits" ]; then
  echo "check-old-docs: these files name a removed process doc. Next: point them at AGENTS.md \"Process\" or the script:"
  printf '%s\n' "$hits" | cut -c1-160 | sed 's/^/  /'
  exit 1
fi
echo "check-old-docs: ok"
