#!/usr/bin/env python3
"""Seed prohibited edges and a protobuf leak, and require the intended diagnostic."""
from pathlib import Path
import json
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]


def expect(args, diagnostic=None):
    result = subprocess.run(args, capture_output=True, text=True)
    output = result.stdout + result.stderr
    if diagnostic is None:
        if result.returncode:
            raise SystemExit(output)
    elif not result.returncode or diagnostic not in output:
        raise SystemExit(f"expected rejection containing {diagnostic!r}: {output}")


with tempfile.TemporaryDirectory() as temp:
    fixture = Path(temp)
    for path in ["scripts/check-layers", "ios/DSHKit/Package.swift", "ios/dsh-mobile.xcodeproj/project.pbxproj"]:
        (fixture / path).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(root / path, fixture / path)
    check = [fixture / "scripts/check-layers"]
    expect(check)
    manifest = fixture / "ios/DSHKit/Package.swift"
    original = manifest.read_text()
    manifest.write_text(original.replace('.target(name: "DSHTransport", dependencies: ["DSHProtocol"])',
                                         '.target(name: "DSHTransport", dependencies: ["DSHCore"])'))
    expect(check, "DSHTransport: found")
    manifest.write_text(original)
    project = fixture / "ios/dsh-mobile.xcodeproj/project.pbxproj"
    saved_project = project.read_bytes()
    graph = json.loads(subprocess.check_output(["plutil", "-convert", "json", "-o", "-", project]))
    objects = graph["objects"]
    widget = next(t for t in objects.values() if t.get("name") == "LiveActivity" and t["isa"] == "PBXNativeTarget")
    frameworks = next(objects[i] for i in widget["buildPhases"] if objects[i]["isa"] == "PBXFrameworksBuildPhase")
    core = next(i for i, f in objects.items() if f.get("productRef") and objects[f["productRef"]]["productName"] == "DSHCore")
    frameworks["files"].append(core)
    project.write_text(json.dumps(graph))
    expect(check, "LiveActivity linked products")
    project.write_bytes(saved_project)
    platform = fixture / "ios/DSHKit/Sources/DSHPlatform/Leak.swift"
    platform.parent.mkdir(parents=True)
    platform.write_text("import DSHCore\n")
    expect(check, "undeclared import DSHCore")
    platform.unlink()
    persistence = fixture / "ios/DSHKit/Sources/DSHCore/Persistence.swift"
    persistence.parent.mkdir(parents=True)
    persistence.write_text("import SwiftData\n")
    expect(check, "SwiftData outside DSHPlatform")
    persistence.write_text("struct TranscriptBlocks {}\n")
    expect(check, "belong with their callers")
    persistence.write_text("let audio = AVAudioSession.sharedInstance()\n")
    expect(check, "iOS app adapter")
    persistence.unlink()
    pairing = persistence.parent / "Pairing/PairedHosts.swift"
    pairing.parent.mkdir()
    pairing.write_text("let records = try Data(contentsOf: url)\n")
    expect(check, "paired-host file I/O belongs to DSHPlatform")
    pairing.unlink()
    shortcut = fixture / "ios/DSHKit/Sources/DSHFeatures/Shortcut.swift"
    shortcut.parent.mkdir(parents=True)
    shortcut.write_text("import DSHTransport\n")
    expect(check, "undeclared import DSHTransport")
    shortcut.write_text("import Foundation; import DSHPlatform\n")
    expect(check, "undeclared import DSHPlatform")
    shortcut.write_text("@_exported import DSHCore\n")
    expect(check, "re-export attribute")
    shortcut.write_text("@_exported\nimport DSHCore\n")
    expect(check, "re-export attribute")

    shortcut.write_text('throw HostConnectionError.bridge(code: "upload/too-large", message: "Too large")\n')
    expect(check, "use Core commands and attachment readers")
    shortcut.write_text("let scoped = url.startAccessingSecurityScopedResource()\n")
    expect(check, "use Core commands and attachment readers")
    shortcut.unlink()
    reader = fixture / "ios/DSHKit/Sources/DSHCore/Reader.swift"
    reader.parent.mkdir(parents=True, exist_ok=True)
    reader.write_text("let bytes = try await pipe.receive()\n")
    expect(check, "through the transport dispatcher")

    package = root / "ios/DSHKit"
    expect(["swift", "build", "--package-path", package, "--target", "DSHProtocol"])
    binary = subprocess.check_output(["swift", "build", "--package-path", package, "--show-bin-path"], text=True).strip()
    probe = fixture / "Leak.swift"
    command = ["swiftc", "-typecheck", "-package-name", "dshkit", "-I", Path(binary) / "Modules", probe]
    probe.write_text("import DSHProtocol\npackage typealias WireFrame = Dshm_V1_Frame\n")
    expect(command)
    probe.write_text("import DSHProtocol\npublic typealias WireFrame = Dshm_V1_Frame\n")
    expect(command, "type alias cannot be declared public because its underlying type uses a package type")
print("Rejected reverse edge, shortcut, re-export and public protobuf alias")
