#!/usr/bin/env python3
"""Guard the plan data in plan/ and what a commit holds. The git pre-commit and pre-merge-commit
hooks run it; scripts/plan and .claude/hooks/plan-guard run it on each change they make.

The rules of a change of plan/ are in scripts/lib/plandata.py (change_errors): the schema and the
graph hold, `passed` is false in every file, no node goes, each item and exit item keeps its tier,
text, files and screens and only gains evidence pointers that resolve, and the logs are
append-only. With --agent, a `human:` pointer is refused too: only the user records a [human] item.

With --staged it also fails on staged build output (.build/, node_modules/, DerivedData/,
*.xcresult) and on staged files larger than MAX_FILE_MB. On main, it fails on a commit that is not
a merge and changes code (CODE_PATHS) or a guard file (PROTECTED): code and guards reach main only
by the merge of a slice branch, and the user reads a guard diff at that merge. A bug that the user
reports becomes a fix slice (`scripts/plan fix`).

During a merge of main into another branch (MERGE_HEAD, or GIT_REFLOG_ACTION in
pre-merge-commit), plan/ is judged against the plan/ of main.

Usage:
  scripts/check-plan                          # the same as --staged
  scripts/check-plan --staged                 # the index against HEAD (the git hooks)
  scripts/check-plan --tree [REF]             # plan/ of REF (default: the working tree) alone
  scripts/check-plan --base DIR --new DIR [--agent]   # a change between two plan/ directories

A change that the user has approved is committed by the user, by hand:
  CHECK_PLAN_ALLOW=1 git commit ...
Agents never set CHECK_PLAN_ALLOW (the Claude Code Bash hook blocks it).

Exit 0 = OK, 1 = refused (each line names the next step), 2 = usage error.
"""

import argparse
import fnmatch
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts" / "lib"))
import plandata  # noqa: E402

PROTECTED = ["scripts/check-plan", ".githooks/*", ".claude/hooks/*", ".claude/settings.json",
             ".codex/hooks.json", ".codex/hooks/*"]
BUILD_OUTPUT = re.compile(r"(^|/)(\.build|node_modules|DerivedData)/|\.xcresult(/|$)")
MAX_FILE_MB = 4
# Code that reaches main only by a merge. scripts/resources.tsv is bookkeeping (scripts/plan assign).
CODE_PATHS = re.compile(r"^(ios|bridge|protocol|spikes|scripts)/(?!resources\.tsv$)")


def git_run(*args):
    return subprocess.run(["git", "-C", str(ROOT), *args], capture_output=True, text=True)


def is_protected(relpath):
    return any(fnmatch.fnmatch(relpath, pat) for pat in PROTECTED)


def merging_main():
    """The other side of a merge in progress, when it is main (or an older commit of main).
    In pre-merge-commit git has no MERGE_HEAD yet, but sets GIT_REFLOG_ACTION="merge <ref>";
    after a merge with conflicts, the commit has MERGE_HEAD."""
    candidates = []
    r = git_run("rev-parse", "-q", "--verify", "MERGE_HEAD")
    if r.returncode == 0:
        candidates.append(r.stdout.strip())
    action = os.environ.get("GIT_REFLOG_ACTION", "").split()
    if action[:1] == ["merge"]:
        candidates += [a for a in action[1:] if not a.startswith("-")]
    for c in candidates:
        r = git_run("rev-parse", "-q", "--verify", f"{c}^{{commit}}")
        if r.returncode != 0:
            continue
        head = r.stdout.strip()
        if git_run("merge-base", "--is-ancestor", head, "main").returncode == 0:
            return head
    return None


def from_commit(path, commit):
    """True if the staged blob of path is the blob in commit (the file comes from there)."""
    a, b = git_run("rev-parse", "-q", f":{path}"), git_run("rev-parse", "-q", f"{commit}:{path}")
    return a.returncode == 0 and a.stdout == b.stdout


def staged_files(*filters):
    r = git_run("diff", "--cached", "--name-only", "-z", *filters)
    return [f for f in r.stdout.split("\0") if f]


def staged_problems(trusted=None):
    """Build output and files larger than MAX_FILE_MB in the index."""
    errors = []
    for f in staged_files("--diff-filter=AM"):
        if trusted and from_commit(f, trusted):
            continue
        if BUILD_OUTPUT.search(f):
            errors.append(f"BUILD OUTPUT STAGED: {f}. Next: add its directory to .gitignore and "
                          f"`git restore --staged {f}`")
            continue
        r = git_run("cat-file", "-s", f":{f}")
        size = int(r.stdout) if r.returncode == 0 and r.stdout.strip().isdigit() else 0
        if size > MAX_FILE_MB * 1024 * 1024:
            errors.append(f"LARGE FILE STAGED: {f} ({size / 1048576:.1f} MB, the limit is {MAX_FILE_MB} MB). "
                          f"Next: `git restore --staged {f}`; keep recordings and builds out of git")
    return errors


def code_on_main():
    """Code or a guard file in the index of a commit on main that is not a merge."""
    if git_run("symbolic-ref", "-q", "--short", "HEAD").stdout.strip() != "main":
        return []
    if (git_run("rev-parse", "-q", "--verify", "MERGE_HEAD").returncode == 0
            or os.environ.get("GIT_REFLOG_ACTION", "").split()[:1] == ["merge"]):
        return []
    errs = []
    for f in staged_files():
        if is_protected(f):
            errs.append(f"GUARD ON MAIN: {f}. Next: change a guard on a slice branch; the user reads "
                        f"the diff when the coordinator merges it")
        elif CODE_PATHS.search(f):
            errs.append(f"CODE ON MAIN: {f}. Next: code reaches main only by the merge of a slice "
                        f"branch; for a bug, `scripts/plan fix` and a fix slice")
    return errs


def dir_files(d):
    """{plan/<name>: text} of the .json files of a directory (a copy of plan/)."""
    d = Path(d)
    if not d.is_dir():
        return {}
    return {f"{plandata.PLAN_DIR}/{p.name}": p.read_text() for p in sorted(d.iterdir()) if p.is_file()}


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    src = ap.add_mutually_exclusive_group()
    src.add_argument("--staged", action="store_true", help="check the index against HEAD")
    src.add_argument("--tree", nargs="?", const="", metavar="REF", help="check plan/ of REF alone")
    src.add_argument("--new", metavar="DIR", help="a changed copy of plan/")
    ap.add_argument("--base", metavar="DIR", help="the copy of plan/ before the change (with --new)")
    ap.add_argument("--agent", action="store_true", help="also refuse a human: pointer")
    args = ap.parse_args(argv)
    if args.base and not args.new:
        ap.error("--base needs --new")

    errors = []
    if args.tree is not None:
        files = dir_files(ROOT / "plan") if args.tree == "" else plandata.head_files(ROOT, args.tree)
        if not files:
            errors.append("NO PLAN: plan/ is empty or missing. Next: the coordinator runs "
                          "scripts/plan new \"<title>\" on main")
        errors += [f"PLAN DATA: {e}" for e in plandata.tree_errors(files)]
    elif args.new:
        base = dir_files(args.base) if args.base else plandata.head_files(ROOT)
        errors += plandata.change_errors(ROOT, base, dir_files(args.new), agent=args.agent)
    else:
        trusted = merging_main()
        base = plandata.head_files(ROOT, trusted or "HEAD")
        staged = plandata.staged_files(ROOT)
        if staged or base:
            errors += plandata.change_errors(ROOT, base, staged, agent=False)
        errors += staged_problems(trusted)
        errors += code_on_main()

    staged_mode = args.tree is None and not args.new
    if errors and staged_mode and os.environ.get("CHECK_PLAN_ALLOW") == "1":
        print("check-plan: CHECK_PLAN_ALLOW=1, committing these user-approved changes:\n")
        print("\n".join(errors))
        return 0
    if errors:
        print("check-plan: refused.\n")
        print("\n".join(errors))
        print("\nIf a rule truly has to give way, tell the user the change and the reason in the "
              "conversation; the user makes that commit by hand.")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
