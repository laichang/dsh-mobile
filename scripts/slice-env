#!/usr/bin/env python3
"""Resources of one slice, from the registry scripts/resources.tsv.

  eval "$(scripts/slice-env S22)"       export the resources of S22 (any worktree)
  scripts/slice-env --assign S22 --branch claude/s22-name [--decisions N]
                                        coordinator, on main: give S22 a slot and a block of
                                        decision numbers, and append the row (no commit)
  scripts/slice-env --list              all rows, with the state of each slice in plan/plan.json

A slot k gives bridge 47810+k, web 3283+k, and a second host at +30 (bridge 47840+k, web 3313+k).
A slot is free when no row with that slot belongs to a slice that is todo, doing or blocked in plan/,
and no process listens on its ports. The decision block (default 3 numbers) starts after the
highest D number in ARCHITECTURE.md on main, on each slice branch, and in the registry. Unused
numbers in a block stay unused. Assigning a slice that already has a row prints that row again.

Exports: DSHM_BRIDGE_PORT DSHM_WEB_PORT DSHM_SECOND_BRIDGE_PORT DSHM_SECOND_WEB_PORT DSHM_HOME
DSHM_SIM DSHM_DECISIONS. Exit 0 = OK, 1 = error, 2 = usage.
"""

import argparse
import json
import shlex
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import dshm  # noqa: E402
import plandata  # noqa: E402


def registry_text(root, prefer_main=False):
    path = root / dshm.REGISTRY
    if not prefer_main and path.exists():
        return path.read_text()
    try:
        return dshm.read_main_file(dshm.REGISTRY)
    except dshm.PlanError:
        return path.read_text() if path.exists() else ""


def find_row(sid, root):
    # main owns the assignment. A worktree can still carry a row from an older plan.
    on_main = dshm.branch() == "main"
    try:
        plan = (plandata.read_plan(root) if on_main else json.loads(dshm.read_main_file(plandata.PLAN_FILE)))
        branch = plandata.find_node(plan, sid).get("branch")
    except (dshm.PlanError, plandata.DataError):
        return None
    if not branch:
        return None
    for main in (not on_main, on_main):
        rows = dshm.parse_registry(registry_text(root, prefer_main=main))
        for row in reversed(rows):
            if row["id"] == sid and row["branch"] == branch:
                return row
    return None


def simulator(name):
    try:
        result = subprocess.run(["xcrun", "simctl", "list", "devices", "available", "-j"],
                                capture_output=True, text=True, check=True)
        devices = json.loads(result.stdout)["devices"]
        matches = [d for runtime, group in devices.items() if ".iOS-" in runtime for d in group
                   if name in (d["name"], d["udid"])]
        if len(matches) == 1:
            return
        if len(matches) > 1:
            raise dshm.PlanError(f"multiple simulators named {name}. Next: select a unique simulator by UDID")
        raise dshm.PlanError(f"simulator {name} is missing. Next: select an available iOS simulator "
                             "or give the slice a new assignment")
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as e:
        raise dshm.PlanError(f"cannot prepare simulator {name}: {getattr(e, 'stderr', None) or e}. "
                             "Next: check Xcode and the installed iOS simulator runtime") from e


def create_simulator(name):
    free, mount = dshm.disk_free()
    if free is not None and free < dshm.min_free_gb() * 1024**2:
        raise dshm.PlanError(f"low disk space on {mount}. Next: free space before creating {name}")
    try:
        result = subprocess.run(["xcrun", "simctl", "create", name, "com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro"],
                                capture_output=True, text=True, check=True)
    except (OSError, subprocess.CalledProcessError) as e:
        raise dshm.PlanError(f"cannot prepare simulator {name}: {getattr(e, 'stderr', None) or e}. "
                             "Next: check Xcode and the installed iOS simulator runtime") from e
    udid = result.stdout.strip()
    if not dshm.SIM_UDID.fullmatch(udid):
        raise dshm.PlanError("invalid simulator identifier from simctl. Next: check the installed iOS runtime")
    return udid


def exports(row):
    env = {
        "DSHM_BRIDGE_PORT": row["bridge"], "DSHM_WEB_PORT": row["web"],
        "DSHM_SECOND_BRIDGE_PORT": row["bridge2"], "DSHM_SECOND_WEB_PORT": row["web2"],
        "DSHM_HOME": dshm.expand_home(row["home"]), "DSHM_SIM": row["sim"],
        "DSHM_DECISIONS": row["decisions"],
    }
    return "\n".join(f"export {k}={shlex.quote(v)}" for k, v in env.items())


def listening(port):
    r = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"],
                       capture_output=True, text=True)
    return bool(r.stdout.strip())


def highest_decision(root, rows):
    nums = set(dshm.decision_numbers((root / "ARCHITECTURE.md").read_text()))
    branches = dshm.git("for-each-ref", "--format=%(refname:short)", "refs/heads/").split("\n")
    for b in branches:
        if b:
            r = subprocess.run(["git", "show", f"{b}:ARCHITECTURE.md"], cwd=root,
                               capture_output=True, text=True)
            if r.returncode == 0:
                nums |= dshm.decision_numbers(r.stdout)
    for row in rows:
        rng = dshm.decision_range(row["decisions"])
        if rng:
            nums.add(rng[1])
    return max(nums) if nums else 0


def assign(sid, branch_name, block, root):
    if dshm.branch() != "main":
        raise dshm.PlanError("--assign runs on main (the coordinator owns the registry). "
                             "Next: run it in the main checkout, or ask the coordinator")
    path = root / dshm.REGISTRY
    rows = dshm.parse_registry(path.read_text())
    old = [r for r in rows if r["id"] == sid]
    if not (root / plandata.PLAN_FILE).exists():
        raise dshm.PlanError(plandata.NO_PLAN)
    nodes = {n["id"]: n for n in plandata.read_plan(root)["nodes"]}
    if sid not in nodes:
        raise dshm.PlanError(f"{sid} is not a node of {plandata.PLAN_FILE}. "
                             f"Next: the coordinator adds it with `scripts/plan add`")
    if old and old[-1]["branch"] == branch_name:
        # A standalone --assign can write its row before plan assign records the branch.
        committed = dshm.parse_registry(registry_text(root, prefer_main=True))
        if nodes[sid].get("branch") == branch_name or old[-1] not in committed:
            simulator(old[-1]["sim"])
            return old[-1], False
    active = {n.get("branch") for n in nodes.values() if n.get("status", "todo") in dshm.ACTIVE}
    held = {int(r["slot"]) for r in rows if r["branch"] in active}
    for slot in range(0, dshm.MAX_SLOT + 1):
        ports = (dshm.BRIDGE_BASE + slot, dshm.WEB_BASE + slot,
                 dshm.BRIDGE_BASE + slot + dshm.SECOND_OFFSET, dshm.WEB_BASE + slot + dshm.SECOND_OFFSET)
        if slot not in held and not any(listening(p) for p in ports):
            break
    else:
        raise dshm.PlanError("no free slot (all held by active slices or listening)")
    first = highest_decision(root, rows) + 1
    decisions = f"D{first}" if block == 1 else f"D{first}-D{first + block - 1}"
    udid = create_simulator(f"dshm-{sid}-{first}")
    row = dict(id=sid, branch=branch_name, slot=str(slot), bridge=str(ports[0]), web=str(ports[1]),
               bridge2=str(ports[2]), web2=str(ports[3]), sim=udid,
               home=f"~/.dshm/home-{sid.lower()}-{udid}", decisions=decisions, assigned=dshm.today())
    text = path.read_text()
    if not text.endswith("\n"):
        text += "\n"
    path.write_text(text + "\t".join(row[c] for c in dshm.REGISTRY_COLUMNS) + "\n")
    return row, True


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("id", nargs="?")
    ap.add_argument("--assign", action="store_true")
    ap.add_argument("--branch")
    ap.add_argument("--decisions", type=int, default=dshm.DECISION_BLOCK)
    ap.add_argument("--check-sim", metavar="NAME")
    ap.add_argument("--list", action="store_true")
    a = ap.parse_args()
    try:
        if a.check_sim:
            simulator(a.check_sim)
            return 0
        root = dshm.toplevel()
        if a.list:
            status = plandata.statuses(root)
            print("\t".join(dshm.REGISTRY_COLUMNS + ("status",)))
            for r in dshm.parse_registry(registry_text(root)):
                print("\t".join([r[c] for c in dshm.REGISTRY_COLUMNS] + [status.get(r["id"], "?")]))
            return 0
        if not a.id:
            ap.error("give a slice ID")
        sid = dshm.check_id(a.id)
        if a.assign:
            if not a.branch:
                ap.error("--assign needs --branch")
            if a.decisions < 1:
                ap.error("--decisions is at least 1")
            row, new = assign(sid, a.branch, a.decisions, root)
            if not new:
                print(f"slice-env: {sid} already has a row; its resources do not change", file=sys.stderr)
        else:
            row = find_row(sid, root)
            if row is None:
                raise dshm.PlanError(f"{sid} has no row in {dshm.REGISTRY}; the coordinator assigns it "
                                     f"(scripts/plan assign {sid} --branch …)")
        print(exports(row))
        return 0
    except dshm.PlanError as e:
        print(f"slice-env: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
