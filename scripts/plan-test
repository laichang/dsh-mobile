planjson() { # planjson <S1 needs as a JSON list>
  cat > plan/plan.json <<JSON
{"title": "Test · plan/", "nodes": [
  {"id": "T0", "kind": "tracer", "title": "thin path", "needs": [], "branch": "claude/t0-x"},
  {"id": "S1", "kind": "slice", "title": "feature", "needs": $1, "branch": null},
  {"id": "X1", "kind": "spike", "title": "question", "needs": [], "branch": null}]}
JSON
}
item() { printf '{"tier": "%s", "text": "%s", "files": [], "screens": [], "passed": %s}' "$1" "$2" "${3:-false}"; }
items() { # items <ID> <passed of item 0>
  printf '{"id": "%s", "items": [%s, %s]}\n' "$1" "$(item auto "$1 works" "$2")" "$(item ui "$1 shows")" > "plan/$1.json"
}
