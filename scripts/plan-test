line "cmd: a path with .. fails" "$T/cmd.out" "../cmdrepo/ok.sh: is not repo-relative"
line "cmd: an absolute path fails" "$T/cmd.out" "/usr/bin/true: is not repo-relative"
line "cmd: a file that is executable only in the checkout fails" "$T/cmd.out" "plain.sh: is not an executable file of the commit"
line "cmd: a file that is not in the commit fails" "$T/cmd.out" "untracked.sh: is not an executable file of the commit"
line "verify does not run a symlinked cmd (exit 127)" "$T/cmd.out" "run link.sh: 127"

echo "verify and passed: the branch from committed plan data; the merge step"
export DSHM_VERIFY_LOGS="$T/verify-logs"
mkdir -p plan
printf '{"title": "Test · merge", "nodes": [{"id": "S5", "kind": "slice", "title": "merge me", "needs": [], "branch": "claude/s5-m"}]}\n' > plan/plan.json
printf '{"id": "S5", "items": [{"tier": "auto", "text": "S5 works", "files": [], "screens": [], "passed": false, "evidence": ["cmd:s5-check.sh", "cmd:tools/s5-a4.sh", "cmd:deep/checks/outer.sh"]}]}\n' > plan/S5.json
mkdir -p checks && printf '[ "$(cat s5.txt 2>/dev/null)" = yes ]\n' > checks/s5-inner.sh
printf '#!/bin/sh\nexec sh "$(dirname "$0")/checks/s5-inner.sh"\n' > s5-check.sh && chmod +x s5-check.sh
mkdir -p deep/checks deep/shared
printf '# shared check setup\n' > deep/shared/setup.sh
printf '#!/bin/sh\n. "$(dirname "$0")/../shared/setup.sh"\n' > deep/checks/outer.sh
chmod +x deep/checks/outer.sh
mkdir -p tools && printf '#!/bin/sh\nexec sh "$(dirname "$0")/s5-helper"\n' > tools/s5-a4.sh && chmod +x tools/s5-a4.sh
printf '[ "$(cat s5.txt 2>/dev/null)" = yes ]\n' > tools/s5-helper
git add plan s5-check.sh checks tools deep && git commit -q -m "merge fixtures"; BASE=$(git rev-parse HEAD)
git branch claude/s5-m
git worktree add -q "$T/wt-s5" claude/s5-m
echo no > "$T/wt-s5/s5.txt" && git -C "$T/wt-s5" add s5.txt && git -C "$T/wt-s5" commit -q -m "s5: not done"
sed -i '' 's#"claude/s5-m"#"claude/s5-x"#' plan/plan.json
expect "verify takes the branch from the committed plan.json, not an uncommitted edit" 0 scripts/plan verify S5
scripts/plan passed S5 --json > "$T/m0.json" 2>&1
python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d["branch"]=="claude/s5-m" and d["head"]==sys.argv[2], d' "$T/m0.json" "$(git rev-parse claude/s5-m)" \
  && ok "passed takes the branch from the committed plan.json" || bad "passed: $(head -5 "$T/m0.json")"
git checkout -q -- plan/plan.json
expect "merge: a failing check on the merge commit refuses the merge" 1 scripts/plan merge S5 --into main
[ "$(git rev-parse main)" = "$BASE" ] && ok "merge: a refused merge leaves the target" || bad "main moved"
# The branch's own copy of the tools passes everything; the merge step runs the target's copy.
sed -i '' 's/            code = r.returncode/            code = 0/' "$T/wt-s5/scripts/lib/plandata.py"
(cd "$T/wt-s5" && scripts/plan verify S5 --base main >/dev/null 2>&1 && scripts/plan passed S5 --base main) > "$T/m1.out" 2>&1
has "a changed copy of the tools on the branch passes its own verify" "$T/m1.out" "passed: true"
(cd "$T/wt-s5" && scripts/plan merge S5 --into main) > "$T/m2.out" 2>&1 && bad "merge with the branch's tools passed" \
  || ok "merge from the branch's changed tools still refuses"
has "merge runs the tools of the target" "$T/m2.out" "running the merge tools of main"
[ "$(git rev-parse main)" = "$BASE" ] && ok "merge: the target did not move" || bad "main moved"
git -C "$T/wt-s5" checkout -q -- scripts/lib/plandata.py
sed -i '' 's/S5 works/S5 works (said the branch)/' "$T/wt-s5/plan/S5.json" && git -C "$T/wt-s5" commit -q -am "s5: change the item"
scripts/plan merge S5 --into main > "$T/m3.out" 2>&1 && bad "merge passed with changed items" || ok "merge: the branch may not change the items"
has "merge names the changed items" "$T/m3.out" "the branch changed the items"
git -C "$T/wt-s5" reset -q --hard HEAD~1
# Evidence that the target has and the branch changes stops the merge (also a file that the
# check script runs); a reviewer reads that diff first.
printf '# updated setup\n' >> "$T/wt-s5/deep/shared/setup.sh"
git -C "$T/wt-s5" commit -q -am "update the shared setup"
scripts/plan merge S5 --into main --dry-run > "$T/parent-helper.out" 2>&1
has "a helper reached through its caller's parent needs review" "$T/parent-helper.out" "  deep/shared/setup.sh"
git -C "$T/wt-s5" reset -q --hard HEAD~1
printf 'exit 0\n' > "$T/wt-s5/checks/s5-inner.sh" && git -C "$T/wt-s5" commit -q -am "s5: the inner check passes"
scripts/plan merge S5 --into main > "$T/m5.out" 2>&1 && bad "merge passed with a changed inner check" || ok "merge: a changed file that the check runs refuses"
has "the refusal names the file that the check runs" "$T/m5.out" "  checks/s5-inner.sh"
git -C "$T/wt-s5" reset -q --hard HEAD~1
printf '#!/bin/sh\nexit 0\n' > "$T/wt-s5/s5-check.sh" && git -C "$T/wt-s5" commit -q -am "s5: the check passes"
scripts/plan merge S5 --into main > "$T/m6.out" 2>&1 && bad "merge passed with a changed check (case a)" || ok "merge: a check changed by the branch refuses (case a)"
has "the refusal says why" "$T/m6.out" "evidence changed by the slice: a reviewer or the user must look at it"
has "the refusal names the check" "$T/m6.out" "  s5-check.sh"
[ "$(git rev-parse main)" = "$BASE" ] && ok "merge: the target did not move" || bad "main moved"
expect "merge --allow-changed-evidence for another path still refuses" 1 scripts/plan merge S5 --into main --allow-changed-evidence other.sh
git -C "$T/wt-s5" reset -q --hard HEAD~1
echo yes > "$T/wt-s5/s5.txt" && git -C "$T/wt-s5" commit -q -am "s5: done"; H=$(git rev-parse claude/s5-m)
expect "merge --dry-run: passes" 0 scripts/plan merge S5 --into main --dry-run
[ "$(git rev-parse main)" = "$BASE" ] && ok "merge --dry-run: the target did not move" || bad "main moved on a dry run"
expect "merge: passing checks merge" 0 scripts/plan merge S5 --into main
M=$(git rev-parse main)
[ "$(git rev-list --parents -n 1 "$M")" = "$M $BASE $H" ] && ok "merge: the target is the merge commit of the base and the head" \
  || bad "merge commit: $(git rev-list --parents -n 1 "$M")"
[ "$(cat s5.txt 2>/dev/null)" = yes ] && ok "merge: the checked-out target moved with its files" || bad "the checkout of main did not move"
git notes --ref=refs/notes/dshm-verify show "$M" > "$T/m4.json" 2>&1
python3 -c 'import json,sys; d=json.load(open(sys.argv[1]))["S5"]; assert d["commit"]==sys.argv[2] and d["items"][0]["runs"][0]["exit"]==0, d' "$T/m4.json" "$M" \
  && ok "merge: the results of its own run are on the merge commit" || bad "merge note: $(head -5 "$T/m4.json")"
[ -z "$(git worktree list | grep dshm-merge)" ] && ok "merge removes its clean checkouts" || bad "checkout left: $(git worktree list)"
# A new evidence file of the branch merges; the merge lists it for the reviewer.
printf '#!/bin/sh\nexit 0\n' > "$T/wt-s5/new-check.sh" && chmod +x "$T/wt-s5/new-check.sh"
python3 - "$T/wt-s5/plan/S5.json" <<'PYT'
import json, sys; d = json.load(open(sys.argv[1])); d["items"][0]["evidence"].append("cmd:new-check.sh")
open(sys.argv[1], "w").write(json.dumps(d) + "\n")
PYT
git -C "$T/wt-s5" add -A && git -C "$T/wt-s5" commit -q -m "s5: a new test"
git -C "$T/wt-s5" merge -q main 2>/dev/null
scripts/plan merge S5 --into main > "$T/m7.out" 2>&1 && ok "merge: a new evidence file merges" || bad "new evidence: $(tail -5 "$T/m7.out")"
has "merge lists the new evidence for the reviewer" "$T/m7.out" "new evidence, judged by the reviewer: new-check.sh"
git log -1 --format=%B main | grep -qF "New evidence, judged by the reviewer: new-check.sh" && ok "the merge commit names the new evidence" \
  || bad "merge message: $(git log -1 --format=%B main)"
# Case (a) with the flag, after a reviewer read the diff: merges and records the flag.
M2=$(git rev-parse main)
printf '#!/bin/sh\nexit 0\n' > "$T/wt-s5/s5-check.sh" && git -C "$T/wt-s5" commit -q -am "s5: the check passes"
expect "merge: case (a) refuses again" 1 scripts/plan merge S5 --into main
expect "merge: case (a) with --allow-changed-evidence merges" 0 scripts/plan merge S5 --into main --allow-changed-evidence s5-check.sh
[ "$(git rev-parse main^1)" = "$M2" ] && ok "merge with the flag: the target is the new merge commit" || bad "main: $(git log --oneline -2 main)"
git log -1 --format=%B main | grep -qxF "allow-changed-evidence: s5-check.sh" && ok "the merge commit records the flag and the path" \
  || bad "merge message: $(git log -1 --format=%B main)"
# Case (a4): the check calls a helper as "$(dirname "$0")/helper", which no name scan finds. The
# directory of each cmd: file, and scripts/lib/, are protected as a whole.
printf 'exit 0\n' > "$T/wt-s5/tools/s5-helper"
mkdir -p "$T/wt-s5/scripts/lib" && echo "# changed" >> "$T/wt-s5/scripts/lib/dshm.py"
git -C "$T/wt-s5" commit -q -am "s5: the helper passes"
M3=$(git rev-parse main)
scripts/plan merge S5 --into main > "$T/m8.out" 2>&1 && bad "merge passed with a changed dirname helper (a4)" || ok "merge: a changed helper in the directory of a check refuses (a4)"
has "the refusal names the helper" "$T/m8.out" "  tools/s5-helper"
has "the refusal names a changed file of scripts/lib/" "$T/m8.out" "  scripts/lib/dshm.py"
expect "merge: a flag for only one of the two still refuses" 1 scripts/plan merge S5 --into main --allow-changed-evidence tools/s5-helper
[ "$(git rev-parse main)" = "$M3" ] && ok "merge: the target did not move" || bad "main moved"
expect "merge: (a4) with a flag for each file merges" 0 scripts/plan merge S5 --into main \
  --allow-changed-evidence tools/s5-helper --allow-changed-evidence scripts/lib/dshm.py
git log -1 --format=%B main > "$T/m9.out"
line "the merge commit records the helper" "$T/m9.out" "allow-changed-evidence: tools/s5-helper"
line "the merge commit records the scripts/lib/ file" "$T/m9.out" "allow-changed-evidence: scripts/lib/dshm.py"
git worktree remove --force "$T/wt-s5"
unset DSHM_VERIFY_LOGS
git rm -rq plan s5-check.sh s5.txt checks tools new-check.sh && git checkout -q "$BASE" -- scripts/lib/dshm.py && git commit -q -m "remove merge fixtures"

echo "free-space floor (scripts/demo/lib.sh guard, fake xcrun)"
guard() { # guard <env…>: source lib.sh as a demo does, with the simulator plan-test-sim
  env -u DSHM_GUARD_OWNER PATH="$T/bin:$PATH" DSHM_OWNERS="$T/owners" DSHM_MIN_IDLE=0 DSHM_GUARD_WAIT=0 \
    SIM=plan-test-sim "$@" bash -c 'source scripts/demo/lib.sh && echo guard-passed' 2>&1
}
: > "$T/xcrun.log"
out=$(guard DSHM_FREE_KB=$((29 * 1024 * 1024))); rc=$?
[ $rc != 0 ] && ! grep -q guard-passed <<<"$out" && ok "29 GB free: the guard refuses" || bad "29 GB free: rc $rc: $out"
[ "$(grep -c . <<<"$out")" = 1 ] && grep -q "below the floor of 30 GB (DSHM_MIN_FREE_GB)" <<<"$out" \
  && ok "the refusal is one line that names the floor" || bad "refusal message: $out"
[ -s "$T/xcrun.log" ] && bad "the guard ran simctl before the floor check" || ok "nothing boots below the floor"
out=$(guard DSHM_FREE_KB=$((31 * 1024 * 1024))); rc=$?
[ $rc = 0 ] && grep -q guard-passed <<<"$out" && ok "31 GB free: the guard passes" || bad "31 GB free: rc $rc: $out"
out=$(guard DSHM_FREE_KB=$((29 * 1024 * 1024)) DSHM_MIN_FREE_GB=20); rc=$?
[ $rc = 0 ] && ok "DSHM_MIN_FREE_GB=20 lowers the floor" || bad "DSHM_MIN_FREE_GB=20: rc $rc: $out"
out=$(guard DSHM_MIN_FREE_GB=0); rc=$?
[ $rc = 0 ] && ok "df of \$HOME gives a value (floor 0 passes)" || bad "real measurement: rc $rc: $out"
out=$(guard DSHM_MIN_FREE_GB=100000000); rc=$?
[ $rc != 0 ] && grep -q "GB free on /" <<<"$out" && ok "df of \$HOME is measured (a floor of 100000000 GB refuses)" \
  || bad "real measurement: rc $rc: $out"

echo "failures: $FAIL"
[ $FAIL = 0 ]
