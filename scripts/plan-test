#!/bin/bash
# Tests for scripts/plan: bookkeeping in plan/, the cleanup after a merge, the plan/ graph,
# verifier results. Also scripts/slice-env, the disk lines of scripts/status, dshm_code_key,
# the free-space floor of scripts/demo/lib.sh. All in a temporary clone (the repo is not touched).
# The cleanup tests use a fake xcrun, HOME and /tmp under the temporary directory: no real
# simulator, worktree, branch or directory is deleted.
#   scripts/plan-test        ends with "failures: 0"
set -uo pipefail
SRC="$(git rev-parse --show-toplevel)"
T=$(cd "$(mktemp -d "${TMPDIR:-/tmp}/dshm-plan-test.XXXXXX")" && pwd -P)
trap 'rm -rf "$T"' EXIT
export DSHM_TEST_DEVICES="$T/devices" PATH="$SRC/scripts/fixtures/simctl:$PATH"
FAIL=0
ok()   { printf '  ok    %s\n' "$1"; }
bad()  { printf '  FAIL  %s\n' "$1"; FAIL=$((FAIL + 1)); }
expect() { # expect <name> <0|1> <command…>: exit code 0 = success, 1 = refused
  local name=$1 want=$2; shift 2
  local out; out=$("$@" 2>&1); local rc=$?
  if { [ "$want" = 0 ] && [ $rc = 0 ]; } || { [ "$want" = 1 ] && [ $rc != 0 ]; }; then ok "$name"
  else bad "$name (exit $rc)"; printf '%s\n' "$out" | head -8 | sed 's/^/        /'; fi
}
refused() { # refused <name> <command…>: the command fails and its output names the next step
  local name=$1; shift
  local out; out=$("$@" 2>&1); local rc=$?
  if [ $rc != 0 ] && grep -qF "Next" <<<"$out"; then ok "$name"
  else bad "$name (exit $rc, or no \"Next\")"; printf '%s\n' "$out" | head -8 | sed 's/^/        /'; fi
}
has() { # has <name> <file> <fixed string>
  if grep -qF -- "$3" "$2"; then ok "$1"; else bad "$1: no '$3' in $2"; fi
}
lacks() { # lacks <name> <file> <fixed string>
  if grep -qF -- "$3" "$2"; then bad "$1: '$3' in $2"; else ok "$1"; fi
}
line() { # line <name> <file> <whole line>
  if grep -qxF -- "$3" "$2"; then ok "$1"; else bad "$1: no line '$3' in $2"; sed 's/^/        /' "$2" | head -20; fi
}
pyok() { # pyok <name> <Python expression>: P = plan/plan.json, N = its nodes by ID, I("S1") = items of S1
  if python3 -c 'import json, sys
P = json.load(open("plan/plan.json")); N = {n["id"]: n for n in P["nodes"]}
I = lambda s: json.load(open(f"plan/{s}.json"))["items"]
sys.exit(0 if eval(sys.argv[1]) else 1)' "$2" > "$T/py.err" 2>&1; then ok "$1"
  else bad "$1: $2"; head -3 "$T/py.err" | sed 's/^/        /'; fi
}
notty() { # notty <command…>: run the command with no controlling terminal (as an agent's shell)
  python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' "$@" </dev/null
}
typed() { # typed <answer> <command…>: run the command on a new pseudo-terminal and type <answer>
  python3 - "$@" <<'PY'
import os, pty, sys
answer, argv = sys.argv[1], sys.argv[2:]
pid, fd = pty.fork()
if pid == 0:
    os.execvp(argv[0], argv)
os.write(fd, (answer + "\n").encode())
out = b""
while True:
    try:
        d = os.read(fd, 1024)
    except OSError:
        break
    if not d:
        break
    out += d
sys.stdout.write(out.decode(errors="replace"))
sys.exit(os.waitstatus_to_exitcode(os.waitpid(pid, 0)[1]))
PY
}
clean() { # clean <name> <path…>: nothing uncommitted under the paths
  local n=$1; shift
  [ -z "$(git status --porcelain -- "$@")" ] && ok "$n" || bad "$n: $(git status --porcelain -- "$@" | head -3)"
}

git clone -q "$SRC" "$T/repo"
cd "$T/repo"
git checkout -q -B main HEAD
# The working copy of the tools under test (they may be uncommitted in $SRC).
cp "$SRC"/scripts/xc "$SRC"/scripts/plan "$SRC"/scripts/slice-env "$SRC"/scripts/check-plan "$SRC"/scripts/status "$SRC"/scripts/review scripts/
cp "$SRC"/scripts/demo/lib.sh scripts/demo/lib.sh
mkdir -p scripts/lib && cp "$SRC"/scripts/lib/dshm.py "$SRC"/scripts/lib/plandata.py "$SRC"/scripts/lib/plan.schema.json scripts/lib/
# The registry header only: the rows of a live run must not change the tests.
sed '/^id[[:space:]]/q' "$SRC"/scripts/resources.tsv > scripts/resources.tsv
# The tests make their own plan: they do not depend on a live plan, or on whether one exists.
git rm -rq --ignore-unmatch plan PLAN.md
git add -A scripts && git commit -q -m "tools under test" --allow-empty
git config user.name test; git config user.email test@example.com

echo "no plan"
expect "show with no plan is refused" 1 scripts/plan show S1
scripts/plan log x > "$T/noplan.out" 2>&1
has "the refusal says that no requirement is in progress" "$T/noplan.out" "no requirement is in progress"
has "the refusal names the next step" "$T/noplan.out" "Next:"
expect "lint with no plan fails" 1 scripts/plan lint
expect "slice-env --list with no plan" 0 scripts/slice-env --list
expect "assign with no plan is refused" 1 scripts/slice-env --assign S1 --branch claude/s1-x
lacks "a refused assign writes no registry row" scripts/resources.tsv "claude/s1-x"
expect "review with no plan is refused" 1 scripts/review S1
DSHM_FREE_KB=$((31 * 1024 * 1024)) scripts/status --fast > "$T/noplan-status.out" 2>&1 \
  && ok "status with no plan runs" || bad "status with no plan failed: $(head -5 "$T/noplan-status.out")"
has "status says there is no plan" "$T/noplan-status.out" "🎛 Coordinator · no plan"

echo "plan new, add, lint"
git checkout -q -b claude/s1-x
refused "new on a slice branch is refused" scripts/plan new "Test · plan-test"
[ ! -e plan ] && ok "a refused new writes nothing" || bad "plan/ exists after a refused new"
git checkout -q main && git branch -q -D claude/s1-x
expect "new" 0 scripts/plan new "Test · plan-test" --commit
pyok "plan.json names the requirement and has no nodes" 'P["title"] == "Test · plan-test" and P["nodes"] == [] and P["exit"] == [] and P["pending"] == []'
pyok "the plan log starts" 'P["log"][0]["title"] == "Plan started"'
clean "new --commit commits plan/" plan
refused "new when a plan exists is refused" scripts/plan new "Another"
echo null > plan/plan.json
scripts/plan lint > "$T/null-plan.out" 2>&1
[ $? = 1 ] && ok "lint rejects a null plan" || bad "lint accepted a null plan"
has "lint identifies the invalid plan" "$T/null-plan.out" "plan/plan.json: must be object"
git restore plan/plan.json
expect "lint of a new plan" 0 scripts/plan lint
expect "add tracer" 0 scripts/plan add tracer "thin path" --why "Why." --cuts "Cuts." --done "[auto] The path works"
pyok "the first tracer is T0, todo" 'N["T0"]["kind"] == "tracer" and N["T0"]["title"] == "Tracer bullet: thin path" and N["T0"]["status"] == "todo" and N["T0"]["branch"] is None'
pyok "the items of T0 are in plan/T0.json, not passed" 'I("T0") == [{"tier": "auto", "text": "The path works", "files": [], "screens": [], "passed": False}]'
refused "a tracer with 4 items is refused" scripts/plan add tracer "too big" --why W --cuts C \
  --done "[auto] a" --done "[auto] b" --done "[ui] c" --done "[human] d"
lacks "a refused tracer adds nothing" plan/plan.json "too big"
[ ! -e plan/T1.json ] && ok "a refused tracer writes no items file" || bad "plan/T1.json exists"
expect "add spike" 0 scripts/plan add spike "a question" --why "Why." --cuts "Cuts." --done "[human] The conclusion is written"
pyok "the first spike is X1" 'N["X1"]["kind"] == "spike" and N["X1"]["title"] == "Spike: a question" and N["X1"]["needs"] == []'
expect "add slice" 0 scripts/plan add slice "Feature" --why "Why." --cuts $'- one\n- two' --done "[ui] It shows" --needs "T0, X1"
pyok "the first slice is S1, with Needs as given" 'N["S1"]["title"] == "Feature" and N["S1"]["needs"] == ["T0", "X1"]'
cp plan/S1.json "$T/valid-slice.json"
python3 -c 'import json; p="plan/S1.json"; d=json.load(open(p)); del d["items"][0]["text"]; open(p,"w").write(json.dumps(d))'
scripts/review S1 --dry-run > "$T/invalid-review.out" 2>&1
[ $? = 2 ] && ok "review rejects malformed UI items" || bad "review returned the wrong status for a malformed item"
has "review identifies the slice, item and missing field" "$T/invalid-review.out" "plan/S1.json.items[0]: text is missing"
lacks "review reports the validation error without a traceback" "$T/invalid-review.out" "Traceback"
mv "$T/valid-slice.json" plan/S1.json
pyok "a multi-line value stays as it is" 'N["S1"]["cuts"] == "- one\n- two"'
scripts/plan dag --json > "$T/dag0.json" 2>&1
python3 -c 'import json,sys; g=json.load(open(sys.argv[1])); assert g["order"].index("S1") > max(g["order"].index("T0"), g["order"].index("X1")); assert {"from":"X1","to":"S1"} in g["edges"]' "$T/dag0.json" \
  && ok "dag: S1 comes after its needs" || bad "dag: $(head -5 "$T/dag0.json")"
refused "a slice with no item is refused" scripts/plan add slice "Bad" --why W --cuts C
refused "an item with no tier is refused" scripts/plan add slice "Bad" --why W --cuts C --done "no tier"
refused "Needs an ID the plan does not have is refused" scripts/plan add slice "Bad" --why W --cuts C --done "[auto] x" --needs S9
refused "a slice with 6 items is refused" scripts/plan add slice "Too big" --why W --cuts C \
  --done "[auto] a" --done "[auto] b" --done "[auto] c" --done "[ui] d" --done "[ui] e" --done "[human] f"
refused "a --demo that is not a file is refused" scripts/plan add slice "Bad" --why W --cuts C --done "[auto] x" --demo no/such.sh
lacks "a refused slice adds nothing" plan/plan.json "Too big"
lacks "a refused slice adds nothing (2)" plan/plan.json "Bad"
expect "add a slice with the default Needs" 0 scripts/plan add slice "Second" --why W --cuts C --done "[auto] It works"
pyok "a slice needs the first tracer by default" 'N["S2"]["needs"] == ["T0"]'
expect "fix slice" 0 scripts/plan fix "Keyboard" --bug "it covers the button"
pyok "the fix slice is the next S" 'N["S3"]["title"] == "Fix: Keyboard"'
expect "exit item" 0 scripts/plan add exit "A check on a real iPhone"
pyok "the exit item is [human]" 'P["exit"] == [{"tier": "human", "text": "A check on a real iPhone", "files": [], "screens": [], "passed": False}]'
refused "an exit item that is not [human] is refused" scripts/plan add exit "[auto] No"
expect "lint after the adds" 0 scripts/plan lint
git add -A plan && git commit -qm "plan fixture"
python3 - <<'PY'
import json; p = json.load(open("plan/plan.json")); p["nodes"][0]["extra"] = 1
open("plan/plan.json", "w").write(json.dumps(p))
PY
expect "lint: an unknown field is refused" 1 scripts/plan lint
refused "a write to a plan that fails lint is refused" scripts/plan log "x"
git checkout -q -- plan
rm plan/S2.json
scripts/plan lint > "$T/lint.out" 2>&1 && bad "lint: a node with no items file passes" || ok "lint: a node with no items file is refused"
has "lint names the missing file" "$T/lint.out" "plan/S2.json is missing"
git checkout -q -- plan
echo '{"id": "S8", "items": []}' > plan/S8.json
expect "lint: an items file of no node is refused" 1 scripts/plan lint
rm plan/S8.json

# Two open fixture slices, S90 (with an open [human] item) and S91.
python3 - <<'PY'
import json
p = json.load(open("plan/plan.json"))
for i in ("S90", "S91"):
    p["nodes"].append({"id": i, "kind": "slice", "title": "Test fixture", "needs": [], "branch": None,
                       "status": "todo", "updated": "2026-11-07", "next": "Test fixture", "merge": None,
                       "why": "Test.", "cuts": "Test.", "not": "", "demo": None, "log": []})
    items = [{"tier": "auto", "text": f"The {i} fixture works", "files": [], "screens": [], "passed": False}]
    if i == "S90":
        items.append({"tier": "human", "text": "A test check on a real iPhone", "files": [], "screens": [], "passed": False})
    open(f"plan/{i}.json", "w").write(json.dumps({"id": i, "items": items}, indent=2) + "\n")
open("plan/plan.json", "w").write(json.dumps(p, indent=2, ensure_ascii=False) + "\n")
PY
expect "lint of the fixture slices" 0 scripts/plan lint
git add -A plan && git commit -qm "fixture slices S90, S91"
human="A test check on a real iPhone"

echo "read-only"
expect "title" 0 scripts/plan title
scripts/plan title > "$T/title.out" 2>&1
line "the title names the requirement" "$T/title.out" "🎛 Coordinator · Test · ✅0 👀0 🔨0 ⏸0"
scripts/plan show S90 > "$T/show.out" 2>&1 && ok "show S90" || bad "show S90 failed: $(head -3 "$T/show.out")"
has "show names the node" "$T/show.out" "S90 · Test fixture  [slice]  todo"
has "show lists the items" "$T/show.out" "  2. [human] $human"
refused "show of an ID that is not a node is refused" scripts/plan show S99
expect "slice-env of an unassigned slice is refused" 1 scripts/slice-env S90
expect "bad ID is refused" 1 scripts/plan show Q9

echo "coordinator on main"
# The highest decision number so far: in ARCHITECTURE.md or in a registry row.
prev=$( { grep -oE '^\| D[0-9]+ \|' ARCHITECTURE.md | grep -oE '[0-9]+'
          awk -F'\t' '$1!="id" && $1!~/^#/ && NF>9 {n=$10; sub(/.*D/, "", n); print n+0}' scripts/resources.tsv; } | sort -n | tail -1)
refused "assign with a branch that does not name the slice is refused" scripts/plan assign S90 --branch claude/other
lacks "a refused assign writes no registry row" scripts/resources.tsv "claude/other"
expect "assign S90" 0 scripts/plan assign S90 --branch claude/s90-test --worktree .claude/worktrees/s90 --from abc1234 --commit
scripts/status --fast > "$T/active-status.out" && ok "status runs with an assigned slice" || bad "status failed for an assigned slice"
line "status prints the assigned slice's next action" "$T/active-status.out" "     next: Slice owner builds"
has "registry row for S90" scripts/resources.tsv "S90	claude/s90-test	"
s90d=$(awk -F'\t' '$1=="S90"{print $10}' scripts/resources.tsv)
[ "$s90d" = "D$((prev + 1))-D$((prev + 3))" ] && ok "S90 got the next decision block ($s90d)" || bad "S90 decisions $s90d, highest before $prev"
pyok "plan.json: S90 is doing on its branch" 'N["S90"]["status"] == "doing" and N["S90"]["branch"] == "claude/s90-test"'
pyok "plan log entry for the assignment" 'P["log"][-1]["title"] == "S90 assigned" and P["log"][-1]["body"].startswith("Branch `claude/s90-test`, worktree `.claude/worktrees/s90` (from `abc1234`)")'
clean "assign --commit commits plan/ and the registry" plan scripts/resources.tsv
eval "$(scripts/slice-env S90)"
[ "$DSHM_SIM" = dshm-S90 ] && ok "slice-env exports the simulator" || bad "slice-env DSHM_SIM=$DSHM_SIM"
slot=$(awk -F'\t' '$1=="S90"{print $3}' scripts/resources.tsv)
case "$slot" in 3|5|6) bad "S90 took a slot held by an active slice ($slot)";; *) ok "S90 slot $slot is not held";; esac
expect "assign S90 again keeps its row" 0 scripts/plan assign S90 --branch claude/s90-test
[ "$(grep -c '^S90	' scripts/resources.tsv)" = 1 ] && ok "still one S90 row" || bad "two S90 rows"
pyok "assign again says: same resources" 'P["log"][-1]["body"].endswith("Same resources as before.")'
[ "$(ls "$DSHM_TEST_DEVICES" | wc -l)" -eq 1 ] && ok "retry reuses the only device" || bad "extra simulator"
mkdir -p "$T/build-bin"
echo '#!/bin/bash' > "$T/build-bin/xcodebuild"
echo 'printf "%s\n" "$@" > "$DSHM_TEST_XC_ARGS"' >> "$T/build-bin/xcodebuild"
chmod +x "$T/build-bin/xcodebuild"
expect "build with the assigned device" 0 env PATH="$T/build-bin:$PATH" DSHM_TEST_XC_ARGS="$T/xc-args" scripts/xc build
has "the build selected the assigned device" "$T/xc-args" "platform=iOS Simulator,name=$DSHM_SIM"
refused "missing build destination gives a next step" env DSHM_SIM=dshm-missing scripts/xc build
first_port=$DSHM_BRIDGE_PORT
# A new requirement can reuse an ID while the registry retains its earlier branch.
awk -F'\t' -v OFS='\t' '$1=="S90" {$1="S91"; $2="claude/s91-old"; $8="dshm-S91"; print}' scripts/resources.tsv > "$T/old-row"
cat "$T/old-row" >> scripts/resources.tsv
expect "assign S91 (next block)" 0 scripts/plan assign S91 --branch claude/s91-test
s91d=$(awk -F'\t' '$2=="claude/s91-test"{print $10}' scripts/resources.tsv)
[ "$s91d" = "D$((prev + 4))-D$((prev + 6))" ] && ok "S91 block follows S90 ($s91d)" || bad "S91 decisions $s91d"
(eval "$(scripts/slice-env S91)" && [[ "$DSHM_SIM" == dshm-S91-* && "$DSHM_BRIDGE_PORT" != "$first_port" ]]) \
  && ok "fresh assignment avoids the earlier device and the active slot" || bad "stale assignment"
[ "$(ls "$DSHM_TEST_DEVICES" | wc -l)" -eq 2 ] && ok "parallel nodes own distinct devices" || bad "expected two devices"
git checkout -q -- plan scripts/resources.tsv
expect "row S90 blocked" 0 scripts/plan row S90 blocked --next "Waits for the user"
pyok "row changes the state and the next step" 'N["S90"]["status"] == "blocked" and N["S90"]["next"] == "Waits for the user"'
refused "row with a bad status is refused" scripts/plan row S90 finished
refused "row of an ID that is not a node is refused" scripts/plan row S99 doing
expect "log entry" 0 scripts/plan log "Test entry" --body $'First line.\n- a sub-item'
pyok "plan log entry with its body" 'P["log"][-1]["title"] == "Test entry" and P["log"][-1]["body"] == "First line.\n- a sub-item"'
n0=$(python3 -c 'import json; print(max([r["n"] for r in json.load(open("plan/plan.json"))["pending"]] or [0]))')
expect "pending entry" 0 scripts/plan pending "S90 × S16" decision "A test | item" --commit-ref abc1234
pyok "pending entry as given, with the next number" "P['pending'][-1] == {'n': $((n0 + 1)), 'slice': 'S90 × S16', 'kind': 'decision', 'item': 'A test | item', 'branch': 'main', 'ref': 'abc1234'}"
scripts/plan row S90 doing --dry-run > "$T/dry.out" 2>&1 && ok "dry run" || bad "dry run failed: $(head -3 "$T/dry.out")"
has "dry run prints the diff" "$T/dry.out" '+      "status": "doing",'
pyok "dry run changes nothing" 'N["S90"]["status"] == "blocked"'
git checkout -q -- plan
refused "owner command on main is refused" scripts/plan slice-status S90 doing
refused "evidence on main is refused" scripts/plan evidence S90 1 "cmd:scripts/plan"
clean "refused commands change nothing" plan

echo "slice owner on its branch"
git checkout -q -b claude/s90-test
refused "coordinator command on a slice branch is refused" scripts/plan row S90 doing
refused "owner of another slice is refused" scripts/plan slice-status S91 doing
expect "slice-status S90 doing" 0 scripts/plan slice-status S90 doing
refused "evidence that does not resolve is refused" scripts/plan evidence S90 1 "cmd:no/such.sh"
refused "evidence for an item that does not exist is refused" scripts/plan evidence S90 5 "cmd:scripts/plan"
refused "evidence for a [human] item is refused" scripts/plan evidence S90 2 "cmd:scripts/plan"
refused "a human: pointer on an [auto] item is refused" scripts/plan evidence S90 1 "human:2026-11-10 iPhone"
expect "evidence for item 1" 0 scripts/plan evidence S90 1 "cmd:scripts/plan"
pyok "the pointer is on item 1; passed stays false" 'I("S90")[0]["evidence"] == ["cmd:scripts/plan"] and not I("S90")[0]["passed"]'
scripts/plan evidence S90 1 "cmd:scripts/plan" > "$T/ev.out" 2>&1
line "the same pointer again is no change" "$T/ev.out" "plan: no change"
expect "slice log" 0 scripts/plan slice-log S90 "built, to review" --body $'- Done: a test.\n- Next: review.'
pyok "log entry at the end of the S90 log" 'N["S90"]["log"][-1]["title"] == "built, to review" and N["S90"]["log"][-1]["body"].startswith("- Done: a test.")'
pyok "slice-log does not touch the plan log" 'P["log"][-1]["title"] != "built, to review"'
refused "accept of an [auto] item is refused" scripts/plan accept S90 1 "iPhone 15"
refused "accept with no terminal (an agent's shell) is refused" notty scripts/plan accept S90 2 "iPhone 15"
expect "accept with the wrong ID typed is refused" 1 typed S91 scripts/plan accept S90 2 "iPhone 15"
pyok "a refused accept records nothing" '"evidence" not in I("S90")[1]'
expect "accept a [human] item" 0 typed S90 scripts/plan accept S90 2 "iPhone 15"
pyok "accept writes a dated human: pointer" "I('S90')[1]['evidence'] == ['human:$(date +%F) iPhone 15']"
expect "accept an exit item" 0 typed exit scripts/plan accept exit 1 "iPhone 15"
pyok "the exit item has a human: pointer" "P['exit'][0]['evidence'] == ['human:$(date +%F) iPhone 15']"
git checkout -q -- plan   # the [human] item stays open, so the merge leaves S90 in review
# A provisional choice in ARCHITECTURE.md, as ARCHITECTURE.md writes one, and a commit; then the merge.
printf '%s\n' "- **A test decision (provisional, pending user confirmation):** Text." >> ARCHITECTURE.md
git commit -qam "S90 work"
git checkout -q main
git merge -q --no-ff --no-edit claude/s90-test
M=$(git rev-parse HEAD | cut -c1-7)

# What a slice leaves on the Mac, all under $T: a simulator (fake xcrun), /tmp/dshm-* paths,
# worktrees, branches and DSHM_HOME. claude/s90-dirty is merged but has an untracked file;
# claude/s90-extra has a commit that is not merged. dshm-S900, dshm-s900-dd and dshm-s9-dd belong
# to other slices.
mkdir -p "$T/bin" "$T/home/.dshm/home-s90/profile" "$T/home/.dshm/runtime" "$T/owners"
for d in dshm-s90 dshm-s90-dd dshm-s90-demo dshm-s900-dd dshm-s9-dd dshm-state; do mkdir -p "$T/tmp/$d"; done
echo log > "$T/tmp/dshm-s90-run.log"
git worktree add -q "$T/wt-s90" claude/s90-test
git worktree add -q -b claude/s90-dirty "$T/wt-s90-dirty" "$M"
echo wip > "$T/wt-s90-dirty/wip.txt"
git worktree add -q -b claude/s90-extra "$T/wt-s90-extra" "$M"
(cd "$T/wt-s90-extra" && echo x > extra.txt && git add extra.txt && git commit -qm "not merged")
U90=AAAAAAAA-0000-0000-0000-000000000090; U900=AAAAAAAA-0000-0000-0000-000000000900
cat > "$T/bin/xcrun" <<EOF
#!/bin/bash
echo "\$*" >> "$T/xcrun.log"
case "\$*" in
  "simctl list devices -j") cat <<'JSON'
{"devices": {"com.apple.CoreSimulator.SimRuntime.iOS-26-4": [
  {"name": "dshm-S90", "udid": "$U90", "state": "Booted", "dataPathSize": 2000000000},
  {"name": "dshm-S900", "udid": "$U900", "state": "Shutdown", "dataPathSize": 1000000000},
  {"name": "iPhone 17 Pro", "udid": "AAAAAAAA-0000-0000-0000-000000000001", "state": "Shutdown"}]}}
JSON
  ;;
  "simctl list devices booted") echo "    plan-test-sim (AAAAAAAA-0000-0000-0000-000000000002) (Booted)" ;;
esac
EOF
chmod +x "$T/bin/xcrun"; : > "$T/xcrun.log"
SBX=(env HOME="$T/home" DSHM_TMP_ROOT="$T/tmp" PATH="$T/bin:$PATH" DSHM_REVIEW_DIR="$T/review" DSHM_OWNERS="$T/owners")
still() { # still <name>: each fixture of S90 is still there
  local miss="" f
  for f in "$T/tmp/dshm-s90" "$T/tmp/dshm-s90-dd" "$T/tmp/dshm-s90-demo" "$T/tmp/dshm-s90-run.log" \
    "$T/wt-s90" "$T/home/.dshm/home-s90"; do [ -e "$f" ] || miss="$miss $f"; done
