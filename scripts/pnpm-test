#!/bin/bash
# pnpm test (tsc + node:test) with a short JSON summary (counts, the first errors as file:line).
# The full log goes to --log FILE or to /tmp/dshm-logs/. The exit code is the exit code of pnpm.
#
#   scripts/pnpm-test [--log FILE] [--dir DIR] [pnpm test args…]     default DIR: bridge/
#
# Summary format: scripts/lib/wrap.py.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec python3 "$ROOT/scripts/lib/wrap.py" run pnpm-test "$@"
