#!/usr/bin/env python3
"""Checks that the golden fixtures in protocol/fixtures/ keep their bytes since a commit.

  scripts/check-fixtures-same <rev>

A rename is allowed: each file at <rev> must have a file with the same bytes now, and no file is
new or lost. fixtures.json may change only the `name` of an entry: its entries, in order and
without the names, are the same. Exit 0 = the same bytes, 1 = a byte changed, 2 = usage.
"""
import hashlib
import json
import os
import subprocess
import sys
from collections import Counter

if len(sys.argv) != 2:
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(2)
REV = sys.argv[1]
ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
DIR = 'protocol/fixtures'


def git(*args, text=True):
    return subprocess.run(['git', '-C', ROOT, *args], capture_output=True, text=text, check=True).stdout


def blobs_then():
    out = {}
    for line in git('ls-tree', '-r', REV, '--', DIR).splitlines():
        meta, path = line.split('\t', 1)
        out[path] = git('cat-file', 'blob', meta.split()[2], text=False)
    return out


def blobs_now():
    out = {}
    for path in git('ls-files', '--', DIR).splitlines():
        with open(os.path.join(ROOT, path), 'rb') as f:
            out[path] = f.read()
    return out


def without_names(data):
    doc = json.loads(data)
    return [{k: v for k, v in e.items() if k != 'name'} for e in doc['fixtures']]


then, now = blobs_then(), blobs_now()
problems = []
js = f'{DIR}/fixtures.json'
if without_names(then.pop(js)) != without_names(now.pop(js)):
    problems.append(f'{js}: an entry changed (only a name may change)')
h = lambda d: Counter(hashlib.sha256(b).hexdigest() for b in d.values())
lost, new = h(then) - h(now), h(now) - h(then)
for path, b in sorted(then.items()):
    if hashlib.sha256(b).hexdigest() in lost:
        problems.append(f'{path}: its bytes are gone (changed or removed)')
for path, b in sorted(now.items()):
    if hashlib.sha256(b).hexdigest() in new:
        problems.append(f'{path}: bytes that {REV} does not have')
for p in problems:
    print(p)
if problems:
    sys.exit(1)
print(f'check-fixtures-same: {len(now) + 1} files in {DIR}/ have the same bytes as at {REV}')
