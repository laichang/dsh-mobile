<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Debug builds only (Release uses Release-Info.plist). Merged with the generated keys.
     Registers the reserved dshm:// scheme for the pairing deep link.
     Release builds have no URL scheme; scripts/check-release-clean verifies that. -->
<plist version="1.0">
<dict>
	<!-- The bridge is reached by plain ws:// at the IP addresses in the
	     pairing QR (LAN, Tailscale 100.x, any other interface of the Mac). ATS refuses cleartext to
	     IPs outside the local ranges, and NSExceptionDomains cannot name IP addresses. Every frame is
	     Noise-encrypted (D6, D21), and the app talks to no other server. Same key in Debug and
	     Release (scripts/check-release-clean compares them). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>chang.dsh-mobile.debug</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dshm</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
