        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前请求的额度已用尽"
          }
        }
      }
    },
    "Send a message below to continue in this session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下面发条消息，就在这个会话里接着做。"
          }
        }
      }
    },
