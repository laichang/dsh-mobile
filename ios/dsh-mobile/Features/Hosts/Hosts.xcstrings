{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%lld / %lld online": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld 在线"
          }
        }
      }
    },
    "%lld waiting on you until it is back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项在等它回来"
          }
        }
      }
    },
    "Approval allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许一次"
          }
        }
      }
    },
    "Approval denied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "Audit records": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审计记录"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Connect to this host to see its devices and audit records.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连上这台执行端后才能看设备和审计记录。"
          }
        }
      }
    },
    "Connecting…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接…"
          }
        }
      }
    },
    "DSH needs an update": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要更新 DSH"
          }
        }
      }
    },
    "Default %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 %@"
          }
        }
      }
    },
    "Device %@ will lose access to %@. It must pair again to reconnect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备 %1$@ 将不能再连 %2$@，要重新配对才能连上。"
          }
        }
      }
    },
    "Device paired": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对设备"
          }
        }
      }
    },
    "Device revoked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吊销设备"
          }
        }
      }
    },
    "End-to-end encrypted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端到端加密"
          }
        }
      }
    },
    "Hosts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行端"
          }
        }
      }
    },
    "Join the same Wi-Fi as your computer, or turn on Tailscale. The app reconnects by itself, and past sessions open while offline.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到和电脑同一个 Wi‑Fi，或打开 Tailscale。连上后自动恢复，历史会话离线也能看。"
          }
        }
      }
    },
    "Load older records": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载更早的记录"
          }
        }
      }
    },
    "Never connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没连上过"
          }
        }
      }
    },
    "No host is online. New tasks can't start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行端都离线，暂时不能下任务"
          }
        }
      }
    },
    "No new tasks until it is updated": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新前不能下新任务"
          }
        }
      }
    },
    "No records yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有记录。"
          }
        }
      }
    },
    "Not encrypted (debug)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未加密（调试）"
          }
        }
      }
    },
    "Offline · last connected %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线 · 最后连接 %@"
          }
        }
      }
    },
    "Offline · never connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线 · 还没连上过"
          }
        }
      }
    },
    "Online": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线"
          }
        }
      }
    },
    "Pair a new host": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对新执行端"
          }
        }
      }
    },
    "Paired %@ · last connected %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对于 %1$@ · 最后连接 %2$@"
          }
        }
      }
    },
    "Paired devices": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的设备"
          }
        }
      }
    },
    "Revoke": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吊销"
          }
        }
      }
    },
    "Revoke this device's access?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吊销这台设备的访问？"
          }
        }
      }
    },
    "Revoke this device?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吊销这台设备？"
          }
        }
      }
    },
    "This device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备"
          }
        }
      }
    },
    "This phone will lose access to %@. To use it again, pair again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机将不能再连 %@。要再用，需要重新配对。"
          }
        }
      }
    },
    "installed %@, supported %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已装 %1$@，支持 %2$@"
          }
        }
      }
    }
  }
}