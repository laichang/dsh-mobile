{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ revoked this phone's access. To use it again, pair it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已吊销这台手机的访问。要再用它，请重新配对。"
          }
        }
      }
    },
    "%lld / %lld online": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld 在线"
          }
        }
      }
    },
    "%lld waiting on you until it is back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项在等它回来"
          }
        }
      }
    },
    "Access removed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问已被吊销"
          }
        }
      }
    },
    "Another program uses port %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个程序占用了端口 %@"
          }
        }
      }
    },
    "Another program uses this port, not the DSH bridge": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个程序占用了这个端口，不是 DSH 桥接"
          }
        }
      }
    },
    "Approval allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许一次"
          }
        }
      }
    },
    "Approval denied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "Audit records": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审计记录"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Connect to this host to see its devices and audit records.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连上这台执行端后才能看设备和审计记录。"
          }
        }
      }
    },
    "Connecting…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接…"
          }
        }
      }
    },
    "DSH needs an update": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要更新 DSH"
          }
        }
      }
    },
    "Default %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 %@"
          }
        }
      }
    },
    "Device %@ will lose access to %@. It must pair again to reconnect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备 %1$@ 将不能再连 %2$@，要重新配对才能连上。"
          }
        }
      }
    },
    "Device paired": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对设备"
          }
        }
      }
    },
    "Device revoked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吊销设备"
          }
        }
      }
    },
    "End-to-end encrypted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端到端加密"
          }
        }
      }
    },
    "Hosts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行端"
          }
        }
      }
    },
    "Join the same Wi-Fi as your computer, or turn on Tailscale. The app reconnects by itself, and past sessions open while offline.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到和电脑同一个 Wi‑Fi，或打开 Tailscale。连上后自动恢复，历史会话离线也能看。"
          }
        }
      }
    },
    "Load older records": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载更早的记录"
          }
        }
      }
    },
    "Never connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没连上过"
          }
        }
      }
    },
    "No host is online. New tasks can't start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行端都离线，暂时不能下任务"
          }
        }
      }
    },
    "No new tasks until it is updated": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新前不能下新任务"
          }
        }
      }
    },
    "No records yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有记录。"
          }
        }
      }
    },
    "In-process test host": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用内测试主机"
          }
        }
      }
    },
    "Not reachable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上这台电脑"
          }
        }
      }
    },
    "Nothing listens on port %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口 %@ 上没有程序在监听"
          }
        }
      }
    },
    "Nothing listens on this port": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有程序在这个端口上监听"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "Offline · last connected %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线 · 最后连接 %@"
          }
        }
      }
    },
    "Offline · never connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线 · 还没连上过"
          }
        }
      }
    },
    "Online": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线"
          }
        }
      }
    },
    "Pair a new host": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对新执行端"
          }
        }
      }
    },
    "Paired %@ · last connected %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对于 %1$@ · 最后连接 %2$@"
          }
        }
      }
    },
    "Paired devices": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的设备"
          }
        }
      }
    },
    "Revoke": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吊销"
          }
        }
      }
    },
    "Revoke this device's access?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吊销这台设备的访问？"
          }
        }
      }
    },
    "Revoke this device?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吊销这台设备？"
          }
        }
      }
    },
    "Start DSH on the computer, with the dsh-mobile bridge on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上启动 DSH，并开着 dsh-mobile 桥接。"
          }
        }
      }
    },
    "Stop that program on the computer, or give the bridge another port in DSH and pair again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上停掉那个程序，或在 DSH 里给桥接换个端口，再重新配对。"
          }
        }
      }
    },
    "This device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备"
          }
        }
      }
    },
    "This phone will be removed from %@. %@ will leave the drawer, with nothing left to tap, and the phone will not reconnect to it. To use it again, pair again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机会从 %1$@ 移除。之后侧边栏里不再有 %2$@，没有可点的入口，手机也不会再去连它。要再用，需要重新配对。"
          }
        }
      }
    },
    "Via %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经 %@"
          }
        }
      }
    },
    "Your computer answers, but its DSH bridge does not. Check DSH there. The app reconnects by itself, and past sessions open while offline.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑连得上，但它的 DSH 桥接没有应答。去电脑上看看 DSH；连上后自动恢复，历史会话离线也能看。"
          }
        }
      }
    },
    "installed %@, supported %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已装 %1$@，支持 %2$@"
          }
        }
      }
    }
  }
}
