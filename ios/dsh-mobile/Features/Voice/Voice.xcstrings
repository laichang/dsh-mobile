            "value" : "关闭"
          }
        }
      }
    },
    "Dictate" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音输入"
          }
        }
      }
    },
    "Listening… Tap the mic again when you are done. Nothing is sent until you tap send." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在听……说完再点一下麦克风。点发送之前不会发出。"
          }
        }
      }
    },
    "Open Settings" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开设置"
          }
        }
      }
    },
    "Speech to text is not available for this language on this iPhone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 上没有这种语言的语音转文字。"
          }
        }
      }
    },
    "Stop dictation" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止语音输入"
          }
        }
      }
    },
    "The microphone is not available." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风不可用。"
          }
        }
      }
    },
    "The speech did not become text: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音没有转成文字：%@"
          }
        }
      }
    },
    "This iPhone does not allow speech recognition (Screen Time or device management)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 不允许语音识别（屏幕使用时间或设备管理）。"
          }
        }
      }
    },
    "Voice input is off. To turn it on, open Settings › dsh-mobile and turn on Microphone and Speech Recognition." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音输入已关闭。要打开，前往 设置 › dsh-mobile，打开「麦克风」和「语音识别」。"
          }
        }
      }
    }
