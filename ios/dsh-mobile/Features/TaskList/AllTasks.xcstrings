{
  "sourceLanguage": "en",
  "strings": {
    "%@ must reconnect before you can answer. The task stays paused; nothing is allowed by default.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 重新连上后才能回复；任务一直暂停，不会默认放行"
          }
        }
      }
    },
    "%@ needs a bridge update before you can answer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要更新桥接插件后才能回复"
          }
        }
      }
    },
    "%@ offline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 离线"
          }
        }
      }
    },
    "%@ offline · last connected %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 离线 · 最后连接 %@"
          }
        }
      }
    },
    "%@ · connecting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 连接中"
          }
        }
      }
    },
    "%@ · offline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 离线"
          }
        }
      }
    },
    "%@ · update needed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 需要更新"
          }
        }
      }
    },
    "%lld hosts": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld host"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld hosts"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 台执行端"
          }
        }
      }
    },
    "Allow once": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许一次"
          }
        }
      }
    },
    "Approve %@?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准 %@？"
          }
        }
      }
    },
    "Connecting to %@. You can answer when it is connected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接 %@，连上后才能回复"
          }
        }
      }
    },
    "Deny": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        }
      }
    },
    "Hide tool arguments": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起工具参数"
          }
        }
      }
    },
    "Operation details unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取操作详情"
          }
        }
      }
    },
    "Running": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在跑"
          }
        }
      }
    },
    "Tool arguments ›": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具参数 ›"
          }
        }
      }
    },
    "Waiting on me": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等我处理"
          }
        }
      }
