{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld hosts online": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld 台执行端在线"
