    "New session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新会话"
          }
        }
      }
    },
    "No tasks yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有任务"
          }
        }
      }
    },
    "Scan the code from the pairing command in your computer’s terminal, or paste its link. Use the same Wi-Fi or connect both devices to Tailscale.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描电脑终端里发码命令生成的配对码，或粘贴链接。手机和电脑需连接同一 Wi-Fi，或两端都连接 Tailscale。"
          }
        }
      }
    },
    "One sentence for your agent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入要完成的任务"
          }
        }
      }
    },
    "Open the drawer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开抽屉"
          }
        }
      }
    },
    "Pair": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对"
          }
        }
      }
    },
    "Pair a computer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对电脑"
          }
        }
      }
    },
    "Pair a host": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对电脑"
          }
        }
      }
    },
    "Paired with %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已与%@配对"
          }
        }
      }
    },
    "Pairing lets this phone send tasks to that host. Everything between them is end-to-end encrypted; the code works once.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对后，手机可以向这台电脑发送任务。连接采用端到端加密，配对码仅可使用一次。"
          }
        }
      }
    },
    "Pairing…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在配对…"
          }
        }
      }
    },
    "Paste the pairing link": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴配对链接"
          }
        }
