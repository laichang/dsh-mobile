{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld hosts online": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld 台执行端在线"
          }
        }
      }
    },
    "%lld waiting on you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件等你处理"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Addresses": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
    "All tasks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有任务"
          }
        }
      }
    },
    "Bridge setup instructions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥接插件安装说明"
          }
        }
      }
    },
    "Camera unavailable. Use the link printed under the code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头不可用。可以粘贴配对码下方的链接。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Close the drawer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭抽屉"
          }
        }
      }
    },
    "Code expires": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码有效期"
          }
        }
      }
    },
    "Connect your computer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你的电脑"
          }
        }
      }
    },
    "Couldn't open your paired computers": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开已配对的电脑"
          }
        }
      }
    },
    "Couldn't pair: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对失败：%@"
          }
        }
      }
    },
    "Default workspace": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认工作区"
          }
        }
      }
    },
    "Devices and audit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备与审计"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Follow-ups come in a later version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补充消息将在后续版本支持"
          }
        }
      }
    },
    "For a fresh code, run this command from the dsh-mobile project folder on your computer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要获取新的配对码，请在电脑的 dsh-mobile 项目目录里运行以下命令。"
          }
        }
      }
    },
    "Host": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑"
          }
        }
      }
    },
    "Host key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机密钥"
          }
        }
      }
    },
    "Hosts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行端"
          }
        }
      }
    },
    "Last connected %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次连接 %@"
          }
        }
      }
    },
    "Need a pairing code?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到配对码？"
          }
        }
      }
    },
    "New session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新会话"
          }
        }
      }
    },
    "No tasks yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有任务"
          }
        }
      }
    },
    "On your computer, find the pairing code in the terminal where DSH started. Keep your phone on the same Wi-Fi or connect through a private network such as Tailscale.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑启动 DSH 的终端中找到配对码。让手机和电脑连接同一 Wi-Fi，或使用 Tailscale 等专用网络。"
          }
        }
      }
    },
    "One sentence for your agent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入要完成的任务"
          }
        }
      }
    },
    "Open the drawer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开抽屉"
          }
        }
      }
    },
    "Pair": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对"
          }
        }
      }
    },
    "Pair a computer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对电脑"
          }
        }
      }
    },
    "Pair a host": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对电脑"
          }
        }
      }
    },
    "Paired with %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已与%@配对"
          }
        }
      }
    },
    "Pairing lets this phone send tasks to that host. Everything between them is end-to-end encrypted; the code works once.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对后，手机可以向这台电脑发送任务。连接采用端到端加密，配对码仅可使用一次。"
          }
        }
      }
    },
    "Pairing…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在配对…"
          }
        }
      }
    },
    "Paste the pairing link": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴配对链接"
          }
        }
      }
    },
    "Point the camera at the pairing code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将摄像头对准配对码。"
          }
        }
      }
    },
    "Protocol": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协议"
          }
        }
      }
    },
    "Ready to pair": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以配对"
          }
        }
      }
    },
    "Say hello and describe one way you can help me on this computer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打个招呼，并举例说明你能在这台电脑上帮我做什么。"
          }
        }
      }
    },
    "Send": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送"
          }
        }
      }
    },
    "Send a task from a new session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新会话里发送任务。"
          }
        }
      }
    },
    "Send tasks from your phone, follow their progress, and answer approval requests. DeepSeek Harness runs the tasks on your computer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上发起任务、查看进度、处理审批。任务由电脑上的 DeepSeek Harness 执行。"
          }
        }
      }
    },
    "Send your first task when you're ready.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备好后，发送你的第一个任务。"
          }
        }
      }
    },
    "Session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        }
      }
    },
    "Tasks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务"
          }
        }
      }
    },
    "This host has no device management.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台电脑不支持设备管理。"
          }
        }
      }
    },
    "To get started, you need a computer running DeepSeek Harness (DSH) with the dsh-mobile bridge enabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请准备一台已运行 DeepSeek Harness（DSH）的电脑，并启用 dsh-mobile 桥接插件。"
          }
        }
      }
    },
    "Try a first task": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试第一个任务"
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "Use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "You can edit the suggestion before sending it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送前，你可以编辑这条建议。"
          }
        }
      }
    },
    "connecting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接中"
          }
        }
      }
    },
    "drawer.newSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建会话"
          }
        }
      }
    },
    "offline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线"
          }
        }
      }
    },
    "the host": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑"
          }
        }
      }
    },
    "update the bridge": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需更新桥接"
          }
        }
      }
    }
  },
  "version": "1.0"
}