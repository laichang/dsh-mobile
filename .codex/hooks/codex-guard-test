#!/usr/bin/env python3
"""Feeds codex-guard synthetic Codex hook inputs and checks each decision. Run: .codex/hooks/codex-guard-test"""

import json, os, shutil, subprocess, tempfile
import pathlib
HERE = pathlib.Path(__file__).resolve()
REPO = HERE.parents[2]
# The tests do not depend on the state of the live PLAN.md (it can have no open items).
# They run a copy of the guards in a temporary root, with this slice added to a copy of PLAN.md.
human = "- [ ] [human] The guard test fixture reads well — Evidence:"
auto_unt = "- [ ] [auto] The guard test fixture runs — Evidence:"
FIXTURE = f"\n### S99 · Guard test fixture\n\n{auto_unt}\n{human}\n"
TMP = tempfile.TemporaryDirectory()
R = os.path.realpath(TMP.name)
for f in [".codex/hooks/codex-guard", ".claude/hooks/git-guard", ".claude/hooks/plan-guard", "scripts/check-plan"]:
    (pathlib.Path(R) / f).parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(REPO / f, pathlib.Path(R) / f)
(pathlib.Path(R) / ".git").mkdir()
LIVE = REPO / "PLAN.md"   # no PLAN.md while no requirement is in progress
(pathlib.Path(R) / "PLAN.md").write_text((LIVE.read_text() if LIVE.exists() else "# PLAN · guard test\n") + FIXTURE)
G = R + "/.codex/hooks/codex-guard"
ENV = {k: v for k, v in os.environ.items() if k != "CLAUDE_PROJECT_DIR"}
ESC = "CHECK_PLAN" + "_ALLOW"
NOV = "--no-" + "verify"
HP = "core.hooks" + "Path"


def run(tool, cmd, cwd=R):
    r = subprocess.run([G], input=json.dumps({"tool_name": tool, "tool_input": {"command": cmd}, "cwd": cwd}),
                       capture_output=True, text=True, env=ENV)
    if r.returncode:
        print(r.stderr)
    out = r.stdout.strip()
    return json.loads(out)["hookSpecificOutput"]["permissionDecision"] if out else "allow"


def patch(path, old, new):
    return f"*** Begin Patch\n*** Update File: {path}\n@@\n-{old}\n+{new}\n*** End Patch"


cases = [
    ("bash plain", "Bash", "git status", "allow"),
    ("bash skip-hooks flag", "Bash", f"git commit {NOV} -m x", "deny"),
    ("bash hooks path", "Bash", f"git config {HP} /tmp", "deny"),
    ("bash escape var", "Bash", ESC + "=1 git commit -m x", "deny"),
    ("bash grep for the flag", "Bash", f'grep -n "{NOV}" WORKFLOW.md', "allow"),
    ("bash writes PLAN", "Bash", "echo x >> PLAN.md", "deny"),
    ("bash writes a guard", "Bash", "cp /tmp/x scripts/check-plan", "deny"),
    ("bash plan script", "Bash", 'scripts/plan log "x"', "allow"),
    ("tick human (rel)", "apply_patch", patch("PLAN.md", human, human.replace("- [ ]", "- [x]") + " human:2026-11-05 x"), "deny"),
    ("tick human (abs)", "apply_patch", patch(R + "/PLAN.md", human, human.replace("- [ ]", "- [x]") + " human:2026-11-05 x"), "deny"),
    ("reword item", "apply_patch", patch("PLAN.md", auto_unt, auto_unt.replace("[auto] ", "[auto] Reworded: ", 1)), "deny"),
    ("tick auto no evidence", "apply_patch", patch("PLAN.md", auto_unt, auto_unt.replace("- [ ]", "- [x]")), "deny"),
    ("delete PLAN", "apply_patch", "*** Begin Patch\n*** Delete File: PLAN.md\n*** End Patch", "deny"),
    ("harmless PLAN edit", "apply_patch", patch("PLAN.md", "# PLAN", "# PLAN"), "allow"),
    ("edit check-plan", "apply_patch", patch("scripts/check-plan", "x", "y"), "deny"),
    ("edit codex hooks.json", "apply_patch", patch(".codex/hooks.json", "x", "y"), "deny"),
    ("edit claude hook from subdir", "apply_patch", patch("../.claude/hooks/git-guard", "x", "y"), "deny"),
    ("add file in .githooks", "apply_patch", "*** Begin Patch\n*** Add File: .githooks/post-commit\n+echo\n*** End Patch", "deny"),
    ("move onto guard", "apply_patch", "*** Begin Patch\n*** Update File: a.txt\n*** Move to: .githooks/pre-commit\n@@\n-a\n+b\n*** End Patch", "deny"),
    ("normal code edit", "apply_patch", patch("bridge/src/index.ts", "x", "y"), "allow"),
]
fail = 0
for name, tool, cmd, want in cases:
    cwd = R + "/bridge" if "subdir" in name else R
    got = run(tool, cmd, cwd)
    ok = got == want
    fail += not ok
    print("PASS" if ok else "FAIL", name, got)
print("failures:", fail)
raise SystemExit(1 if fail else 0)
