#!/usr/bin/env python3
"""Claude Code PreToolUse hook (Edit|Write|MultiEdit and Bash) guarding plan/*.json and the guards.

Paths count in the checkout that holds them: the main checkout or any worktree of this repo
(a checkout with scripts/check-plan). So a session in main that edits a file under
.claude/worktrees/<name>/ is checked too.

Edit, Write, MultiEdit:
  * guard files (PROTECTED: scripts/check-plan, .githooks/*, .claude/hooks/*,
    .claude/settings.json, .codex/hooks.json, .codex/hooks/*) -> ask: an agent blocked by a
    check must not quietly change the check.
  * plan/<name>.json: computes the file as it would be after the tool call and judges it with
    check-plan --agent against the plan/ on disk (so it judges this edit, not earlier ones; the
    git pre-commit hook judges the cumulative change against HEAD).
      recording a [human] item        -> deny (only the user records those)
      any other check-plan violation  -> NON_HUMAN_DECISION
Bash (it parses the command with the parser of git-guard):
  * a write to plan/<name>.json (redirection, tee, sed -i, cp/mv onto it, rm, or program code
    that names it and writes files) -> deny: use scripts/plan, or the Edit tool, which this hook
    checks.
  * a write to a guard file -> ask, as for Edit.
Other hooks (codex-guard) call bash_writes() and edit_decision().
"""

import fnmatch
import importlib.util
import json
import os
import re
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

# "ask" pops a confirmation dialog for the user; verified on 2026-11-04 that it
# still does in bypass-permissions mode.
NON_HUMAN_DECISION = "ask"

HERE = Path(__file__).resolve().parent
ROOT = Path(os.environ.get("CLAUDE_PROJECT_DIR") or HERE.parents[1])
# Keep in sync with PROTECTED in scripts/check-plan.
PROTECTED = ["scripts/check-plan", ".githooks/*", ".claude/hooks/*", ".claude/settings.json",
             ".codex/hooks.json", ".codex/hooks/*"]
GUARD_TEXT = re.compile(r"scripts/check-plan|\.githooks/|\.claude/hooks/|\.claude/settings\.json|"
                        r"\.codex/hooks")
PLAN_PATH = re.compile(r"^plan/[^/]+\.json$")
PLAN_TEXT = re.compile(r"""['"]([^'"\n]*plan/[^'"\n]*\.json)['"]""")
CODE_WRITES = re.compile(r"write_text|write_bytes|\.write\(|open\([^)\n]*,\s*['\"][^'\"]*[wax+]|"
                         r"writeFileSync|appendFileSync|createWriteStream|os\.replace|os\.rename|"
                         r"shutil\.(copy|move)|os\.remove|unlink\(|truncate\(")
REDIRECTS = {">", ">>", ">|", "&>", "&>>"}
COPIERS = {"cp", "mv", "install", "rsync", "ditto", "ln"}
REMOVERS = {"rm", "unlink", "truncate", "shred"}
IN_PLACE = {"sed", "gsed", "perl"}

PLAN_REASON = ("plan/: do not write a plan file from a shell command. Next: use scripts/plan "
               "(row, log, pending, assign, merged, evidence, slice-log, slice-status), or the "
               "Edit tool, which this hook checks with check-plan.")
GUARD_REASON = ("{rel} is a guard file: it enforces the plan/ and git hook rules. Approve only "
                "if you asked for this change to the guard itself in the conversation; an agent "
                "blocked by a check must not change the check instead. Next: tell the user the "
                "change and the reason, and let the user make it.")


def decide(decision, reason):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": decision,
        "permissionDecisionReason": reason,
    }}))
    sys.exit(0)


def repo_path(path, cwd=None):
    """(checkout root, path relative to it) if path is in a checkout of this repo, else None."""
    p = Path(os.path.expanduser(str(path)))
    if not p.is_absolute():
        p = Path(cwd or os.getcwd()) / p
    try:
        p = p.resolve()
    except OSError:
        return None
    for d in [p.parent, *p.parent.parents]:
        if (d / ".git").exists():
            if not (d / "scripts" / "check-plan").exists():
                return None
            return d, p.relative_to(d).as_posix()
    return None


def kind_of(path, cwd=None):
    hit = repo_path(path, cwd)
    if not hit:
        return None, None
    root, rel = hit
    if PLAN_PATH.match(rel):
        return "plan", rel
    if any(fnmatch.fnmatch(rel, pat) for pat in PROTECTED):
        return "guard", rel
    return None, rel


# ------------------------------------------------------------------------------- Edit / Write

def proposed(tool, inp, current):
    if tool == "Write":
        return inp.get("content", "")
    edits = inp.get("edits") if tool == "MultiEdit" else [inp]
    text = current
    for e in edits or []:
        old, new = e.get("old_string", ""), e.get("new_string", "")
        if not old or old not in text:
            return None  # the tool itself will fail; nothing to judge
        text = text.replace(old, new) if e.get("replace_all") else text.replace(old, new, 1)
    return text


def load_check_plan(root):
    loader = SourceFileLoader("check_plan", str(root / "scripts" / "check-plan"))
    spec = importlib.util.spec_from_loader("check_plan", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def edit_decision(tool, inp):
    """(decision, reason) for an Edit/Write/MultiEdit, or None."""
    hit = repo_path(inp.get("file_path") or "")
    if not hit:
        return None
    root, rel = hit
    if any(fnmatch.fnmatch(rel, pat) for pat in PROTECTED):
        return "ask", GUARD_REASON.format(rel=rel)
    if not PLAN_PATH.match(rel):
        return None
    plan = root / rel
    current = plan.read_text() if plan.exists() else ""
    new = proposed(tool, inp, current)
    if new is None:
        return None
    errors = load_check_plan(root).edit_errors(rel, new)
    if not errors:
        return None
    body = "\n".join(errors)
    if any(e.startswith("HUMAN ITEM") for e in errors):
        return "deny", (f"{rel}: only the user records a [human] item. Next: tell the user what "
                        "you verified and let them record it.\n\n" + body)
    if NON_HUMAN_DECISION == "ask":
        return "ask", (f"{rel}: items keep their text and only gain evidence that resolves. This "
                       "edit breaks that; approve only if you agreed to it in the conversation. "
                       "Next: see each error below.\n\n" + body)
    return "deny", (f"{rel}: items keep their text and only gain evidence that resolves. Next: "
                    "don't retry; tell the user the original text, the new text and the reason, "
                    "and let the user make the edit.\n\n" + body)


# ------------------------------------------------------------------------------- Bash

def git_guard():
    loader = SourceFileLoader("git_guard", str(HERE / "git-guard"))
    spec = importlib.util.spec_from_loader("git_guard", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def bash_writes(cmd, cwd=None, depth=0, gg=None):
    """[(kind, rel)] for each write to plan/<name>.json ('plan') or a guard file ('guard')."""
    gg = gg or git_guard()
    cwd = cwd or os.getcwd()
    hits = []

    def target(path):
        k, rel = kind_of(path, cwd)
        if k:
            hits.append((k, rel))

    for seg, bodies, pipeline in gg.shell_segments(cmd):
        assigns, prog, args = gg.command_of(seg)
        for j, t in enumerate(seg):
            if t in REDIRECTS and j + 1 < len(seg):
                target(seg[j + 1])
        plain = [a for a in args if not a.startswith("-") and a not in REDIRECTS]
        if prog == "cd":
            if args:
                cwd = os.path.join(cwd, os.path.expanduser(args[0]))
            continue
        if prog == "tee":
            for a in plain:
                target(a)
        elif prog in IN_PLACE and any(re.match(r"^-[a-zA-Z]*i", a) for a in args):
            for a in plain:
                target(a)
        elif prog == "mv" and plain:
            for a in plain:          # mv also removes its source
                target(a)
        elif prog in COPIERS and plain:
            target(plain[-1])
        elif prog == "git":
            sub = next((a for a in plain if a in ("mv", "rm")), None)
            if sub:                  # git mv / git rm move or remove tracked files
                for a in plain[plain.index(sub) + 1:]:
                    target(a)
        elif prog in REMOVERS:
            for a in plain:
                target(a)
        elif prog == "dd":
            for a in args:
                if a.startswith("of="):
                    target(a[3:])
        if depth >= 4:
            continue
        if prog in gg.SHELLS:
            for script in gg.shell_script_args(prog, args) + [b for b in bodies if b]:
                hits += bash_writes(script, cwd, depth + 1, gg)
        elif prog == "eval":
            hits += bash_writes(" ".join(args), cwd, depth + 1, gg)
        elif gg.INTERPRETER.match(prog or ""):
            code = "\n".join(args + bodies)
            if CODE_WRITES.search(code):
                for lit in PLAN_TEXT.findall(code):
                    target(lit)
                m = GUARD_TEXT.search(code)
                if m:
                    hits.append(("guard", m.group(0)))
        if len(pipeline) > 1:
            later = [gg.command_of(s) for s in pipeline[pipeline.index(seg) + 1:]]
            if any(p in gg.SHELLS and gg.reads_stdin_as_code(p, a) for _, p, a in later):
                hits += bash_writes(" ".join(args), cwd, depth + 1, gg)
    return hits


def bash_decision(cmd, cwd=None):
    if "plan/" not in cmd and not GUARD_TEXT.search(cmd):
        return None
    hits = bash_writes(cmd, cwd)
    if any(k == "plan" for k, _ in hits):
        return "deny", PLAN_REASON
    guards = [rel for k, rel in hits if k == "guard"]
    if guards:
        return "ask", GUARD_REASON.format(rel=guards[0])
    return None


def main():
    data = json.load(sys.stdin)
    tool, inp = data.get("tool_name"), data.get("tool_input") or {}
    if tool == "Bash":
        result = bash_decision(inp.get("command", ""), data.get("cwd"))
    else:
        result = edit_decision(tool, inp)
    if result:
        decide(*result)


if __name__ == "__main__":
    main()
