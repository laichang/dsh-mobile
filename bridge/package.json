{
  "name": "@dsh-mobile/bridge",
  "version": "0.1.0",
  "description": "DSH companion plugin for dsh-mobile: a loopback WebSocket listener speaking protocol/frame.proto",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "lib/src/index.js",
  "files": [
    "lib/src",
    "cordis.patch.yml"
  ],
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test \"lib/test/**/*.test.js\"",
    "typecheck": "tsc -p . --noEmit",
    "fixtures": "tsc -p . && node lib/scripts/fixtures.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
