{
  "name": "@dsh-mobile/bridge",
  "version": "0.1.0",
  "description": "DSH companion plugin for dsh-mobile over pinned TLS 1.3",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/src/index.js",
  "files": [
    "lib/src",
    "lib/scripts/pair.js",
    "cordis.patch.yml"
  ],
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9",
    "dsh": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p .",
    "test": "corepack pnpm build && node --test \"lib/test/**/*.test.js\"",
    "typecheck": "tsc -p . --noEmit",
    "fixtures": "tsc -p . && node lib/scripts/fixtures.js",
    "pair": "node lib/scripts/pair.js",
    "pretest": "test -x node_modules/.bin/tsc || corepack pnpm install --offline --frozen-lockfile"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "uqr": "0.1.3",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
